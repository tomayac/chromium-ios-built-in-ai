-private final class DownloadDelegate: NSObject, URLSessionTaskDelegate, @unchecked Sendable {
+/// Downloads one large file in a way that survives being interrupted, even
+/// by the app being killed.
+///
+/// Bytes go straight into `<destination>.partial`. Next to it,
+/// `<destination>.partial.json` records the server's ETag and the total size,
+/// so a later attempt asks only for the rest (`Range`), and only if the file
+/// on the server is still the same one (`If-Range`). Otherwise the server
+/// sends all of it, and the download starts over. The finished file is moved
+/// into place once its size matches.
+final class ResumableDownload: NSObject, URLSessionDataDelegate, @unchecked Sendable {
+  private struct State: Codable {
+    var etag: String?
+    var total: Int64
+  }
+
+  private let url: URL
+  private let destination: URL
+  private let partial: URL
+  private let stateFile: URL
   private let onProgress: @Sendable (Double) -> Void
-  private var observation: NSKeyValueObservation?
 
-  init(onProgress: @escaping @Sendable (Double) -> Void) { self.onProgress = onProgress }
+  // Only touched on the session's delegate queue, one attempt at a time.
+  private var file: FileHandle?
+  private var received: Int64 = 0
+  private var state = State(etag: nil, total: 0)
+  private var lastReported = -1.0
+  private var failure: Error?
+  private var continuation: CheckedContinuation<Void, Error>?
+
+  init(url: URL, destination: URL, onProgress: @escaping @Sendable (Double) -> Void) {
+    self.url = url
+    self.destination = destination
+    self.partial = destination.appendingPathExtension("partial")
+    self.stateFile = destination.appendingPathExtension("partial.json")
+    self.onProgress = onProgress
+  }
+
+  /// One attempt. Throws when it is interrupted, leaving what arrived for the
+  /// next attempt.
+  func run() async throws {
+    var request = URLRequest(url: url)
+    request.cachePolicy = .reloadIgnoringLocalCacheData
+    let resumable = loadState()
+    if let resumable {
+      request.setValue("bytes=\(received)-", forHTTPHeaderField: "Range")
+      if let etag = resumable.etag {
+        request.setValue(etag, forHTTPHeaderField: "If-Range")
+      }
+    }
+    let session = URLSession(configuration: .default, delegate: self, delegateQueue: nil)
+    defer { session.finishTasksAndInvalidate() }
+    let task = session.dataTask(with: request)
+    try await withTaskCancellationHandler {
+      try await withCheckedThrowingContinuation { continuation in
+        self.continuation = continuation
+        task.resume()
+      }
+    } onCancel: {
+      task.cancel()
+    }
+  }
+
+  /// Picks up the partial file of an earlier attempt, if there is one to pick
+  /// up. Returns its state, or nil to start from scratch.
+  private func loadState() -> State? {
+    let fileManager = FileManager.default
+    guard let data = try? Data(contentsOf: stateFile),
+      let saved = try? JSONDecoder().decode(State.self, from: data),
+      let size = (try? fileManager.attributesOfItem(atPath: partial.path))?[.size] as? Int64,
+      size > 0, size < saved.total
+    else {
+      try? fileManager.removeItem(at: partial)
+      try? fileManager.removeItem(at: stateFile)
+      received = 0
+      return nil
+    }
+    state = saved
+    received = size
+    return saved
+  }
+
+  private func saveState() {
+    if let data = try? JSONEncoder().encode(state) {
+      try? data.write(to: stateFile, options: .atomic)
+    }
+  }
+
+  private func finish(_ error: Error?) {
+    try? file?.close()
+    file = nil
+    let continuation = self.continuation
+    self.continuation = nil
+    if let error {
+      continuation?.resume(throwing: error)
+    } else {
+      continuation?.resume()
+    }
+  }
+
+  // MARK: URLSessionDataDelegate
+
+  func urlSession(
+    _ session: URLSession, dataTask: URLSessionDataTask, didReceive response: URLResponse,
+    completionHandler: @escaping (URLSession.ResponseDisposition) -> Void
+  ) {
+    guard let http = response as? HTTPURLResponse else {
+      failure = BuiltInAIError.network("The model download got no HTTP response.")
+      completionHandler(.cancel)
+      return
+    }
+    do {
+      switch http.statusCode {
+      case 206:
+        // The rest of the same file. "Content-Range: bytes <from>-<to>/<total>"
+        let range = http.value(forHTTPHeaderField: "Content-Range") ?? ""
+        guard range.hasPrefix("bytes \(received)-"),
+          let total = Int64(range.split(separator: "/").last ?? "")
+        else {
+          // Not where we left off. Start over on the next attempt.
+          try? FileManager.default.removeItem(at: stateFile)
+          throw URLError(.cannotParseResponse)
+        }
+        state.total = total
+      case 200:
+        // All of it: a first attempt, or the file changed on the server.
+        received = 0
+        state = State(
+          etag: http.value(forHTTPHeaderField: "ETag"), total: http.expectedContentLength)
+        FileManager.default.createFile(atPath: partial.path, contents: nil)
+        if state.total > 0 {
+          try ensureSpace(for: state.total)
+          saveState()
+        } else {
+          // Sent without a length, compressed on the fly for instance, so it
+          // can be neither checked nor resumed. It still downloads.
+          try? FileManager.default.removeItem(at: stateFile)
+        }
+      default:
+        throw BuiltInAIError.network("The model download failed with HTTP \(http.statusCode).")
+      }
+      let handle = try FileHandle(forWritingTo: partial)
+      try handle.truncate(atOffset: UInt64(received))
+      try handle.seekToEnd()
+      file = handle
+      report()
+      completionHandler(.allow)
+    } catch {
+      failure = error
+      completionHandler(.cancel)
+    }
+  }
+
+  func urlSession(_ session: URLSession, dataTask: URLSessionDataTask, didReceive data: Data) {
+    guard let file else { return }
+    do {
+      try file.write(contentsOf: data)
+      received += Int64(data.count)
+      report()
+    } catch {
+      failure = error
+      dataTask.cancel()
+    }
+  }
+
+  func urlSession(_ session: URLSession, task: URLSessionTask, didCompleteWithError error: Error?) {
+    if let error = failure ?? error {
+      failure = nil
+      finish(error)
+      return
+    }
+    do {
+      try file?.synchronize()
+      guard state.total <= 0 || received == state.total else {
+        throw URLError(.networkConnectionLost)
+      }
+      let fileManager = FileManager.default
+      try? fileManager.removeItem(at: destination)
+      try fileManager.moveItem(at: partial, to: destination)
+      try? fileManager.removeItem(at: stateFile)
+      finish(nil)
+    } catch {
+      finish(error)
+    }
+  }
+
+  /// Reports progress in steps of a tenth of a percent at most.
+  private func report() {
+    guard state.total > 0 else { return }
+    let fraction = Double(received) / Double(state.total)
+    if fraction - lastReported >= 0.001 || fraction >= 1 {
+      lastReported = fraction
+      onProgress(min(fraction, 1))
+    }
+  }
 
-  func urlSession(_ session: URLSession, didCreateTask task: URLSessionTask) {
-    observation = task.progress.observe(\.fractionCompleted) { [onProgress] progress, _ in
-      onProgress(progress.fractionCompleted)
+  private func ensureSpace(for total: Int64) throws {
+    // Space for important use counts what the system would free up, and is 0
+    // on volumes that do not track it, such as external ones on a Mac.
+    let values = try? destination.deletingLastPathComponent().resourceValues(
+      forKeys: [.volumeAvailableCapacityForImportantUsageKey, .volumeAvailableCapacityKey])
+    let important = values?.volumeAvailableCapacityForImportantUsage ?? 0
+    let plain = Int64(values?.volumeAvailableCapacity ?? 0)
+    let available = max(important, plain)
+    if available > 0, available < total + 500_000_000 {
+      throw BuiltInAIError(
+        name: "QuotaExceededError",
+        message: "The model needs \(total / 1_000_000) MB of free space.")
     }
   }
 }
