+  extension GemmaStats {
+    /// Records a lifecycle event of the engine with the app's memory, and
+    /// again `measureAfter` seconds later, once the engine had time to go.
+    static func event(_ name: String, detail: String, measureAfter: TimeInterval? = nil) {
+      write(eventEntry(name, detail: detail))
+      if let measureAfter {
+        DispatchQueue.global().asyncAfter(deadline: .now() + measureAfter) {
+          write(eventEntry("\(name) +\(Int(measureAfter))s", detail: detail))
+        }
+      }
+    }
+
+    private static func eventEntry(_ name: String, detail: String) -> [String: Any] {
+      var entry: [String: Any] = [
+        "time": ISO8601DateFormatter().string(from: Date()),
+        "event": name,
+        "detail": detail,
+      ]
+      if let footprint = MemoryFootprint.current() {
+        entry["footprintMB"] = footprint.now >> 20
+        entry["peakFootprintMB"] = footprint.peak >> 20
+      }
+      #if os(iOS)
+        entry["availableMemoryMB"] = os_proc_available_memory() >> 20
+      #endif
+      return entry
+    }
+  }
