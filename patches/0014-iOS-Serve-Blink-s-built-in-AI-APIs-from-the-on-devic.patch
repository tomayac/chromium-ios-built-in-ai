+++ b/ios/chrome/app/resources/BUILD.gn
@@ -197,6 +197,17 @@ bundle_data_xcassets("built_in_ai_icons") {
   ]
 }
 
+# The icon of the build with Blink: the same, with a segment of the Chromium
+# logo in the lower right corner.
+bundle_data_xcassets("built_in_ai_blink_icons") {
+  catalog = "BuiltInAIBlinkIcons.xcassets"
+  sources = [
+    "BuiltInAIBlinkIcons.xcassets/AppIcon.appiconset/Contents.json",
+    "BuiltInAIBlinkIcons.xcassets/AppIcon.appiconset/Icon-1024.png",
+    "BuiltInAIBlinkIcons.xcassets/Contents.json",
+  ]
+}
+
