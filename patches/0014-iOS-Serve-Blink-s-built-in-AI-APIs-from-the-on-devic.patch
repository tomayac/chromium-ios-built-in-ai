+
+namespace built_in_ai {
+
+namespace {
+
+using blink::mojom::AILanguageModelPromptContent;
+using blink::mojom::AILanguageModelPromptPtr;
+using blink::mojom::AILanguageModelPromptRole;
+using blink::mojom::ModelAvailabilityCheckResult;
+using blink::mojom::ModelStreamingResponseStatus;
+
+// Gemma's sampling defaults, which Apple's model follows as well.
+constexpr uint32_t kDefaultTopK = 64;
+constexpr float kDefaultTemperature = 1.0;
+constexpr uint32_t kMaxTopK = 128;
+constexpr float kMaxTemperature = 2.0;
+
+// Download progress goes to Blink as a share of this many bytes.
+constexpr uint64_t kProgressTotal = 0x10000;
+
+std::string TypeName(blink::mojom::AILanguageModelPromptType type) {
+  switch (type) {
+    case blink::mojom::AILanguageModelPromptType::kImage:
+      return "image";
+    case blink::mojom::AILanguageModelPromptType::kAudio:
+      return "audio";
+    default:
+      return "text";
+  }
+}
+
+// `expectedInputs` and `expectedOutputs`, as the engine reads them.
+base::ListValue ExpectedList(
+    const std::optional<std::vector<blink::mojom::AILanguageModelExpectedPtr>>&
+        expected) {
+  base::ListValue list;
+  if (!expected) {
+    return list;
+  }
+  for (const auto& entry : *expected) {
+    base::DictValue item;
+    item.Set("type", TypeName(entry->type));
+    if (entry->languages) {
+      base::ListValue languages;
+      for (const auto& language : *entry->languages) {
+        languages.Append(language->code);
+      }
+      item.Set("languages", std::move(languages));
+    }
+    list.Append(std::move(item));
+  }
+  return list;
+}
+
+base::DictValue EngineOptions(
+    const blink::mojom::AILanguageModelCreateOptions& options) {
+  base::DictValue result;
+  result.Set("expectedInputs", ExpectedList(options.expected_inputs));
+  result.Set("expectedOutputs", ExpectedList(options.expected_outputs));
+  if (options.sampling_params) {
+    result.Set("topK", base::checked_cast<int>(options.sampling_params->top_k));
+    result.Set("temperature", options.sampling_params->temperature);
+  }
+  return result;
+}
+
+ModelAvailabilityCheckResult ToAvailability(const std::string& value) {
+  if (value == "available") {
+    return ModelAvailabilityCheckResult::kAvailable;
+  }
+  if (value == "downloadable") {
+    return ModelAvailabilityCheckResult::kDownloadable;
+  }
+  if (value == "downloading") {
+    return ModelAvailabilityCheckResult::kDownloading;
+  }
+  return ModelAvailabilityCheckResult::kUnavailableUnknown;
+}
+
+ModelStreamingResponseStatus ToStatus(const EngineClient::Error& error) {
+  if (error.name == "AbortError") {
+    return ModelStreamingResponseStatus::kErrorCancelled;
+  }
+  if (error.name == "QuotaExceededError") {
+    return ModelStreamingResponseStatus::kErrorInputTooLarge;
+  }
+  if (error.name == "NotSupportedError" || error.name == "SyntaxError") {
+    return ModelStreamingResponseStatus::kErrorInvalidRequest;
+  }
+  if (error.name == "NotAllowedError") {
+    return ModelStreamingResponseStatus::kErrorPermissionDenied;
+  }
+  return ModelStreamingResponseStatus::kErrorGenericFailure;
+}
+
+// 16-bit PCM WAV of Blink's float samples, which come interleaved.
+std::vector<uint8_t> ToWav(const on_device_model::mojom::AudioData& audio) {
+  const uint32_t channels = base::checked_cast<uint32_t>(audio.channel_count);
+  const uint32_t rate = base::checked_cast<uint32_t>(audio.sample_rate);
+  const uint32_t data_size =
+      base::checked_cast<uint32_t>(audio.data.size() * sizeof(int16_t));
+  std::vector<uint8_t> wav;
+  wav.reserve(44 + data_size);
+  auto append = [&wav](base::span<const uint8_t> bytes) {
+    wav.insert(wav.end(), bytes.begin(), bytes.end());
+  };
+  auto text = [&append](std::string_view s) {
+    append(base::as_byte_span(s));
+  };
+  text("RIFF");
+  append(base::U32ToLittleEndian(36 + data_size));
+  text("WAVEfmt ");
+  append(base::U32ToLittleEndian(16));
+  append(base::U16ToLittleEndian(1));  // PCM.
+  append(base::U16ToLittleEndian(static_cast<uint16_t>(channels)));
+  append(base::U32ToLittleEndian(rate));
+  append(base::U32ToLittleEndian(rate * channels * 2));
+  append(base::U16ToLittleEndian(static_cast<uint16_t>(channels * 2)));
+  append(base::U16ToLittleEndian(16));
+  text("data");
+  append(base::U32ToLittleEndian(data_size));
+  for (float sample : audio.data) {
+    float clamped = std::max(-1.0f, std::min(1.0f, sample));
+    append(base::I16ToLittleEndian(static_cast<int16_t>(clamped * 32767)));
+  }
+  return wav;
+}
+
+base::DictValue InlineData(base::span<const uint8_t> data,
+                           std::string_view mime_type) {
+  base::DictValue inline_data;
+  inline_data.Set("data", base::Base64Encode(data));
+  inline_data.Set("mimeType", mime_type);
+  base::DictValue part;
+  part.Set("inlineData", std::move(inline_data));
+  return part;
+}
+
+// One message in the engine's format, Gemini's: a role and parts. Returns
+// nothing for content the engine cannot take, such as tool calls.
+std::optional<base::DictValue> ToEngineMessage(
+    const blink::mojom::AILanguageModelPrompt& prompt) {
+  base::ListValue parts;
+  for (const auto& content : prompt.content) {
+    switch (content->which()) {
+      case AILanguageModelPromptContent::Tag::kText: {
+        base::DictValue part;
+        part.Set("text", content->get_text());
+        parts.Append(std::move(part));
+        break;
+      }
+      case AILanguageModelPromptContent::Tag::kBitmap: {
+        std::optional<std::vector<uint8_t>> png =
+            gfx::PNGCodec::EncodeBGRASkBitmap(content->get_bitmap(),
+                                              /*discard_transparency=*/false);
+        if (!png) {
+          return std::nullopt;
+        }
+        parts.Append(InlineData(*png, "image/png"));
+        break;
+      }
+      case AILanguageModelPromptContent::Tag::kAudio:
+        parts.Append(InlineData(ToWav(*content->get_audio()), "audio/wav"));
+        break;
+      default:
+        return std::nullopt;
+    }
+  }
+  base::DictValue message;
+  switch (prompt.role) {
+    case AILanguageModelPromptRole::kSystem:
+      message.Set("role", "system");
+      break;
+    case AILanguageModelPromptRole::kAssistant:
+      message.Set("role", "model");
+      break;
+    default:
+      message.Set("role", "user");
+      break;
+  }
+  message.Set("parts", std::move(parts));
+  return message;
+}
+
+class BuiltInAIManagerImpl;
+
+// One `LanguageModel` session. Blink sends its prompts one turn at a time and
+// leaves the conversation to the browser, while the engine takes the whole
+// conversation every turn and keeps the model's state for the part it has
+// seen. So this keeps the conversation, and sends all of it.
+class LanguageModel : public blink::mojom::AILanguageModel {
+ public:
+  LanguageModel(BuiltInAIManagerImpl* manager,
+                blink::mojom::AILanguageModelCreateOptionsPtr options)
+      : manager_(manager), options_(std::move(options)) {
+    responders_.set_disconnect_handler(base::BindRepeating(
+        &LanguageModel::OnResponderGone, weak_factory_.GetWeakPtr()));
+  }
+
+  // Creates the engine session, and answers `client`.
+  void Start(
+      mojo::PendingRemote<blink::mojom::AIManagerCreateLanguageModelClient>
+          client,
+      mojo::PendingRemote<on_device_model::mojom::DownloadObserver> monitor,
+      std::vector<base::DictValue> history);
+
+  void set_receiver_id(mojo::ReceiverId id) { receiver_id_ = id; }
+
+  // blink::mojom::AILanguageModel:
+  void Prompt(std::vector<AILanguageModelPromptPtr> prompts,
+              on_device_model::mojom::ResponseConstraintPtr constraint,
+              mojo::PendingRemote<blink::mojom::ModelStreamingResponder>
+                  pending_responder) override;
+  void Append(std::vector<AILanguageModelPromptPtr> prompts,
+              mojo::PendingRemote<blink::mojom::ModelStreamingResponder>
+                  client) override;
+  void Fork(mojo::PendingRemote<blink::mojom::AIManagerCreateLanguageModelClient>
+                client) override;
+  void Destroy() override;
+  void MeasureInputUsage(std::vector<AILanguageModelPromptPtr> input,
+                         MeasureInputUsageCallback callback) override;
+
+ private:
+  void OnCreated(
+      mojo::Remote<blink::mojom::AIManagerCreateLanguageModelClient> client,
+      base::expected<base::Value, EngineClient::Error> result);
+  void OnPromptDone(mojo::RemoteSetElementId responder_id,
+                    std::vector<base::DictValue> turn,
+                    base::expected<base::Value, EngineClient::Error> result);
+  void OnResponderGone(mojo::RemoteSetElementId responder_id);
+  std::optional<std::vector<base::DictValue>> ToMessages(
+      const std::vector<AILanguageModelPromptPtr>& prompts);
+  base::ListValue Contents(const std::vector<base::DictValue>& extra) const;
+  blink::mojom::ModelExecutionContextInfoPtr ContextInfo() const {
+    return blink::mojom::ModelExecutionContextInfo::New(usage_, 0);
+  }
+
+  const raw_ptr<BuiltInAIManagerImpl> manager_;
+  const blink::mojom::AILanguageModelCreateOptionsPtr options_;
+  EngineClient engine_;
+  // The conversation so far, in the engine's format.
+  std::vector<base::DictValue> history_;
+  uint64_t context_window_ = 0;
+  uint64_t usage_ = 0;
+  mojo::ReceiverId receiver_id_ = 0;
+  mojo::RemoteSet<blink::mojom::ModelStreamingResponder> responders_;
+  // Running prompts by responder, to stop them when the page stops reading.
+  std::map<mojo::RemoteSetElementId, std::string> running_;
+  base::WeakPtrFactory<LanguageModel> weak_factory_{this};
+};
+
+class BuiltInAIManagerImpl : public blink::mojom::AIManager {
+ public:
+  static BuiltInAIManagerImpl& Get() {
+    static base::NoDestructor<BuiltInAIManagerImpl> instance;
+    return *instance;
+  }
+
+  void Bind(mojo::PendingReceiver<blink::mojom::AIManager> receiver) {
+    receivers_.Add(this, std::move(receiver));
+  }
+
+  // Takes a language model whose engine session exists.
+  blink::mojom::AILanguageModel* Adopt(
+      std::unique_ptr<LanguageModel> model,
+      mojo::PendingReceiver<blink::mojom::AILanguageModel> receiver) {
+    LanguageModel* raw = model.get();
+    raw->set_receiver_id(models_.Add(std::move(model), std::move(receiver)));
+    return raw;
+  }
+
+  void Remove(mojo::ReceiverId id) { models_.Remove(id); }
+
+  // blink::mojom::AIManager:
+  void CanCreateLanguageModel(
+      blink::mojom::AILanguageModelCreateOptionsPtr options,
+      CanCreateLanguageModelCallback callback) override {
+    base::DictValue body;
+    body.Set("options", EngineOptions(*options));
+    engine_.Call(
+        "availability", std::move(body),
+        base::BindOnce(
+            [](CanCreateLanguageModelCallback callback,
+               base::expected<base::Value, EngineClient::Error> result) {
+              std::move(callback).Run(
+                  result.has_value() && result->is_string()
+                      ? ToAvailability(result->GetString())
+                      : ModelAvailabilityCheckResult::kUnavailableUnknown);
+            },
+            std::move(callback)));
+  }
+
+  void CreateLanguageModel(
+      mojo::PendingRemote<blink::mojom::AIManagerCreateLanguageModelClient>
+          client,
+      blink::mojom::AILanguageModelCreateOptionsPtr options,
+      mojo::PendingRemote<on_device_model::mojom::DownloadObserver> monitor)
+      override {
+    auto model = std::make_unique<LanguageModel>(this, options.Clone());
+    std::vector<base::DictValue> history;
+    for (const auto& prompt : options->initial_prompts) {
+      std::optional<base::DictValue> message = ToEngineMessage(*prompt);
+      if (!message) {
+        mojo::Remote<blink::mojom::AIManagerCreateLanguageModelClient>(
+            std::move(client))
+            ->OnError(blink::mojom::AIManagerCreateClientError::
+                          kUnableToCreateSession,
+                      nullptr);
+        return;
+      }
+      history.push_back(std::move(*message));
+    }
+    AddPending(std::move(model))
+        ->Start(std::move(client), std::move(monitor), std::move(history));
+  }
+
+  // Keeps `model` while its engine session is being created.
+  LanguageModel* AddPending(std::unique_ptr<LanguageModel> model) {
+    pending_.push_back(std::move(model));
+    return pending_.back().get();
+  }
+
+  // Hands a model that finished creating, or failed to, out of `pending_`.
+  std::unique_ptr<LanguageModel> TakePending(LanguageModel* model) {
+    for (auto it = pending_.begin(); it != pending_.end(); ++it) {
+      if (it->get() == model) {
+        std::unique_ptr<LanguageModel> taken = std::move(*it);
+        pending_.erase(it);
+        return taken;
+      }
+    }
+    return nullptr;
+  }
+
+  void CanCreateSummarizer(blink::mojom::AISummarizerCreateOptionsPtr options,
+                           CanCreateSummarizerCallback callback) override {
+    std::move(callback).Run(
+        ModelAvailabilityCheckResult::kUnavailableFeatureNotEnabled);
+  }
+  void CreateSummarizer(
+      mojo::PendingRemote<blink::mojom::AIManagerCreateSummarizerClient> client,
+      blink::mojom::AISummarizerCreateOptionsPtr options,
+      mojo::PendingRemote<on_device_model::mojom::DownloadObserver> monitor)
+      override {
+    mojo::Remote<blink::mojom::AIManagerCreateSummarizerClient>(
+        std::move(client))
+        ->OnError(
+            blink::mojom::AIManagerCreateClientError::kUnableToCreateSession,
+            nullptr);
+  }
+
+  void GetLanguageModelParams(
+      GetLanguageModelParamsCallback callback) override {
+    std::move(callback).Run(blink::mojom::AILanguageModelParams::New(
+        blink::mojom::AILanguageModelSamplingParams::New(kDefaultTopK,
+                                                         kDefaultTemperature),
+        blink::mojom::AILanguageModelSamplingParams::New(kMaxTopK,
+                                                         kMaxTemperature)));
+  }
+
+  void CanCreateWriter(blink::mojom::AIWriterCreateOptionsPtr options,
+                       CanCreateWriterCallback callback) override {
+    std::move(callback).Run(
+        ModelAvailabilityCheckResult::kUnavailableFeatureNotEnabled);
+  }
+  void CreateWriter(
+      mojo::PendingRemote<blink::mojom::AIManagerCreateWriterClient> client,
+      blink::mojom::AIWriterCreateOptionsPtr options,
+      mojo::PendingRemote<on_device_model::mojom::DownloadObserver> monitor)
+      override {
+    mojo::Remote<blink::mojom::AIManagerCreateWriterClient>(std::move(client))
+        ->OnError(
+            blink::mojom::AIManagerCreateClientError::kUnableToCreateSession,
+            nullptr);
+  }
+
+  void CanCreateRewriter(blink::mojom::AIRewriterCreateOptionsPtr options,
+                         CanCreateRewriterCallback callback) override {
+    std::move(callback).Run(
+        ModelAvailabilityCheckResult::kUnavailableFeatureNotEnabled);
+  }
+  void CreateRewriter(
+      mojo::PendingRemote<blink::mojom::AIManagerCreateRewriterClient> client,
+      blink::mojom::AIRewriterCreateOptionsPtr options,
+      mojo::PendingRemote<on_device_model::mojom::DownloadObserver> monitor)
+      override {
+    mojo::Remote<blink::mojom::AIManagerCreateRewriterClient>(
+        std::move(client))
+        ->OnError(
+            blink::mojom::AIManagerCreateClientError::kUnableToCreateSession,
+            nullptr);
+  }
+
+  void CanCreateProofreader(blink::mojom::AIProofreaderCreateOptionsPtr options,
+                            CanCreateProofreaderCallback callback) override {
+    std::move(callback).Run(
+        ModelAvailabilityCheckResult::kUnavailableFeatureNotEnabled);
+  }
+  void CreateProofreader(
+      mojo::PendingRemote<blink::mojom::AIManagerCreateProofreaderClient>
+          client,
+      blink::mojom::AIProofreaderCreateOptionsPtr options,
+      mojo::PendingRemote<on_device_model::mojom::DownloadObserver> monitor)
+      override {
+    mojo::Remote<blink::mojom::AIManagerCreateProofreaderClient>(
+        std::move(client))
+        ->OnError(
+            blink::mojom::AIManagerCreateClientError::kUnableToCreateSession,
+            nullptr);
+  }
+
+  void CanCreateSemanticEmbedder(
+      CanCreateSemanticEmbedderCallback callback) override {
+    std::move(callback).Run(
+        ModelAvailabilityCheckResult::kUnavailableFeatureNotEnabled);
+  }
+  void CreateSemanticEmbedder(
+      mojo::PendingRemote<blink::mojom::AIManagerCreateSemanticEmbedderClient>
+          client,
+      mojo::PendingRemote<on_device_model::mojom::DownloadObserver> monitor)
+      override {
+    mojo::Remote<blink::mojom::AIManagerCreateSemanticEmbedderClient>(
+        std::move(client))
+        ->OnError(
+            blink::mojom::AIManagerCreateClientError::kUnableToCreateSession);
+  }
+
+  void CanCreateDecisionModel(
+      blink::mojom::AIDecisionModelCreateOptionsPtr options,
+      CanCreateDecisionModelCallback callback) override {
+    std::move(callback).Run(
+        ModelAvailabilityCheckResult::kUnavailableFeatureNotEnabled);
+  }
+  void CreateDecisionModel(
+      mojo::PendingRemote<blink::mojom::AIManagerCreateDecisionModelClient>
+          client,
+      blink::mojom::AIDecisionModelCreateOptionsPtr options,
+      mojo::PendingRemote<on_device_model::mojom::DownloadObserver> monitor)
+      override {
+    mojo::Remote<blink::mojom::AIManagerCreateDecisionModelClient>(
+        std::move(client))
+        ->OnError(
+            blink::mojom::AIManagerCreateClientError::kUnableToCreateSession,
+            nullptr);
+  }
+
+ private:
+  friend class base::NoDestructor<BuiltInAIManagerImpl>;
+  BuiltInAIManagerImpl() = default;
+
+  EngineClient engine_;
+  mojo::ReceiverSet<blink::mojom::AIManager> receivers_;
+  mojo::UniqueReceiverSet<blink::mojom::AILanguageModel> models_;
+  // Models whose engine session is being created.
+  std::vector<std::unique_ptr<LanguageModel>> pending_;
+};
+
+void LanguageModel::Start(
+    mojo::PendingRemote<blink::mojom::AIManagerCreateLanguageModelClient>
+        client,
+    mojo::PendingRemote<on_device_model::mojom::DownloadObserver> monitor,
+    std::vector<base::DictValue> history) {
+  history_ = std::move(history);
+  base::DictValue body;
+  body.Set("session", "s");
+  body.Set("options", EngineOptions(*options_));
+  // Blink only asks for a model download with user activation.
+  body.Set("userActivated", true);
+  auto on_progress = base::BindRepeating(
+      [](mojo::Remote<on_device_model::mojom::DownloadObserver>* observer,
+         double loaded) {
+        if (*observer) {
+          (*observer)->OnDownloadProgressUpdate(
+              static_cast<uint64_t>(loaded * kProgressTotal), kProgressTotal);
+        }
+      },
+      base::Owned(new mojo::Remote<on_device_model::mojom::DownloadObserver>(
+          std::move(monitor))));
+  engine_.Call("create", std::move(body),
+               base::BindOnce(&LanguageModel::OnCreated,
+                              weak_factory_.GetWeakPtr(),
+                              mojo::Remote<
+                                  blink::mojom::AIManagerCreateLanguageModelClient>(
+                                  std::move(client))),
+               {}, std::move(on_progress));
+}
+
+void LanguageModel::OnCreated(
+    mojo::Remote<blink::mojom::AIManagerCreateLanguageModelClient> client,
+    base::expected<base::Value, EngineClient::Error> result) {
+  std::unique_ptr<LanguageModel> self = manager_->TakePending(this);
+  if (!result.has_value() || !result->is_dict() || !client) {
+    if (client) {
+      client->OnError(
+          blink::mojom::AIManagerCreateClientError::kUnableToCreateSession,
+          nullptr);
+    }
+    return;
+  }
+  context_window_ = static_cast<uint64_t>(
+      result->GetDict().FindDouble("contextWindow").value_or(0));
+  // Roughly four characters a token, until the first turn counts them.
+  for (const auto& message : history_) {
+    if (const base::ListValue* parts = message.FindList("parts")) {
+      for (const auto& part : *parts) {
+        if (const std::string* text = part.GetDict().FindString("text")) {
+          usage_ += (text->size() + 3) / 4;
+        }
+      }
+    }
+  }
+
+  auto info = blink::mojom::AILanguageModelInstanceInfo::New();
+  info->input_quota = context_window_;
+  info->input_usage = usage_;
+  info->sampling_params =
+      options_->sampling_params
+          ? options_->sampling_params.Clone()
+          : blink::mojom::AILanguageModelSamplingParams::New(
+                kDefaultTopK, kDefaultTemperature);
+  std::vector<blink::mojom::AILanguageModelPromptType> input_types = {
+      blink::mojom::AILanguageModelPromptType::kText};
+  if (options_->expected_inputs) {
+    for (const auto& expected : *options_->expected_inputs) {
+      if (expected->type != blink::mojom::AILanguageModelPromptType::kText) {
+        input_types.push_back(expected->type);
+      }
+    }
+  }
+  info->input_types = std::move(input_types);
+
+  mojo::PendingRemote<blink::mojom::AILanguageModel> remote;
+  manager_->Adopt(std::move(self), remote.InitWithNewPipeAndPassReceiver());
+  client->OnResult(std::move(remote), std::move(info));
+}
+
+std::optional<std::vector<base::DictValue>> LanguageModel::ToMessages(
+    const std::vector<AILanguageModelPromptPtr>& prompts) {
+  std::vector<base::DictValue> messages;
+  for (const auto& prompt : prompts) {
+    // The engine cannot go on from a given start of the answer yet.
+    if (prompt->is_prefix) {
+      return std::nullopt;
+    }
+    std::optional<base::DictValue> message = ToEngineMessage(*prompt);
+    if (!message) {
+      return std::nullopt;
+    }
+    messages.push_back(std::move(*message));
+  }
+  return messages;
+}
+
+base::ListValue LanguageModel::Contents(
+    const std::vector<base::DictValue>& extra) const {
+  base::ListValue contents;
+  for (const auto& message : history_) {
+    contents.Append(message.Clone());
+  }
+  for (const auto& message : extra) {
+    contents.Append(message.Clone());
+  }
+  return contents;
+}
+
+void LanguageModel::Prompt(
+    std::vector<AILanguageModelPromptPtr> prompts,
+    on_device_model::mojom::ResponseConstraintPtr constraint,
+    mojo::PendingRemote<blink::mojom::ModelStreamingResponder>
+        pending_responder) {
+  mojo::RemoteSetElementId responder_id =
+      responders_.Add(std::move(pending_responder));
+  std::optional<std::vector<base::DictValue>> turn = ToMessages(prompts);
+  if (!turn) {
+    responders_.Get(responder_id)
+        ->OnError(ModelStreamingResponseStatus::kErrorInvalidRequest, nullptr);
+    return;
+  }
+  base::DictValue body;
+  body.Set("session", "s");
+  body.Set("contents", Contents(*turn));
+  body.Set("stream", true);
+  if (constraint && constraint->is_json_schema()) {
+    std::optional<base::Value> schema = base::JSONReader::Read(
+        constraint->get_json_schema(), base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+    if (!schema || !schema->is_dict()) {
+      responders_.Get(responder_id)
+          ->OnError(ModelStreamingResponseStatus::kErrorInvalidRequest,
+                    nullptr);
+      return;
+    }
+    body.Set("schema", std::move(*schema));
+  } else if (constraint) {
+    // Regular expressions are not supported by the engine.
+    responders_.Get(responder_id)
+        ->OnError(ModelStreamingResponseStatus::kErrorInvalidRequest, nullptr);
+    return;
+  }
+  auto on_chunk = base::BindRepeating(
+      [](base::WeakPtr<LanguageModel> self,
+         mojo::RemoteSetElementId responder_id, const std::string& text) {
+        if (!self) {
+          return;
+        }
+        if (auto* responder = self->responders_.Get(responder_id)) {
+          responder->OnStreaming(text);
+        }
+      },
+      weak_factory_.GetWeakPtr(), responder_id);
+  running_[responder_id] = engine_.Call(
+      "generate", std::move(body),
+      base::BindOnce(&LanguageModel::OnPromptDone, weak_factory_.GetWeakPtr(),
+                     responder_id, std::move(*turn)),
+      std::move(on_chunk));
+}
+
+void LanguageModel::OnPromptDone(
+    mojo::RemoteSetElementId responder_id,
+    std::vector<base::DictValue> turn,
+    base::expected<base::Value, EngineClient::Error> result) {
+  running_.erase(responder_id);
+  blink::mojom::ModelStreamingResponder* responder =
+      responders_.Get(responder_id);
+  if (!result.has_value() || !result->is_dict()) {
+    if (responder) {
+      responder->OnError(result.has_value()
+                             ? ModelStreamingResponseStatus::kErrorGenericFailure
+                             : ToStatus(result.error()),
+                         nullptr);
+    }
+    return;
+  }
+  const base::DictValue& output = result->GetDict();
+  const std::string* text = output.FindString("text");
+  // The exchange becomes part of the conversation.
+  for (auto& message : turn) {
+    history_.push_back(std::move(message));
+  }
+  base::DictValue answer;
+  answer.Set("role", "model");
+  base::ListValue parts;
+  base::DictValue part;
+  part.Set("text", text ? *text : "");
+  parts.Append(std::move(part));
+  answer.Set("parts", std::move(parts));
+  history_.push_back(std::move(answer));
+  usage_ = static_cast<uint64_t>(output.FindDouble("usage").value_or(usage_));
+  if (responder) {
+    responder->OnCompletion(ContextInfo());
+  }
+}
+
+void LanguageModel::OnResponderGone(mojo::RemoteSetElementId responder_id) {
+  auto it = running_.find(responder_id);
+  if (it == running_.end()) {
+    return;
+  }
+  base::DictValue body;
+  body.Set("target", it->second);
+  engine_.Notify("abort", std::move(body));
+  running_.erase(it);
+}
+
+void LanguageModel::Append(
+    std::vector<AILanguageModelPromptPtr> prompts,
+    mojo::PendingRemote<blink::mojom::ModelStreamingResponder> client) {
+  mojo::Remote<blink::mojom::ModelStreamingResponder> responder(
+      std::move(client));
+  std::optional<std::vector<base::DictValue>> messages = ToMessages(prompts);
+  if (!messages) {
+    responder->OnError(ModelStreamingResponseStatus::kErrorInvalidRequest,
+                       nullptr);
+    return;
+  }
+  for (auto& message : *messages) {
+    history_.push_back(std::move(message));
+  }
+  responder->OnCompletion(ContextInfo());
+}
+
+void LanguageModel::Fork(
+    mojo::PendingRemote<blink::mojom::AIManagerCreateLanguageModelClient>
+        client) {
+  std::vector<base::DictValue> history;
+  for (const auto& message : history_) {
+    history.push_back(message.Clone());
+  }
+  // A fork is a new session with the same options and conversation. The
+  // initial prompts are part of the conversation already.
+  auto options = options_.Clone();
+  options->initial_prompts.clear();
+  manager_
+      ->AddPending(
+          std::make_unique<LanguageModel>(manager_, std::move(options)))
+      ->Start(std::move(client), mojo::NullRemote(), std::move(history));
+}
+
+void LanguageModel::Destroy() {
+  engine_.Notify("destroy", base::DictValue().Set("session", "s"));
+  // Deletes this.
+  manager_->Remove(receiver_id_);
+}
+
+void LanguageModel::MeasureInputUsage(
+    std::vector<AILanguageModelPromptPtr> input,
+    MeasureInputUsageCallback callback) {
+  std::optional<std::vector<base::DictValue>> messages = ToMessages(input);
+  if (!messages) {
+    std::move(callback).Run(std::nullopt);
+    return;
+  }
+  base::ListValue contents;
+  for (auto& message : *messages) {
+    contents.Append(std::move(message));
+  }
+  base::DictValue body;
+  body.Set("session", "s");
+  body.Set("contents", std::move(contents));
+  engine_.Call("countTokens", std::move(body),
+               base::BindOnce(
+                   [](MeasureInputUsageCallback callback,
+                      base::expected<base::Value, EngineClient::Error> result) {
+                     std::optional<uint32_t> tokens;
+                     if (result.has_value() && result->is_int()) {
+                       tokens = base::saturated_cast<uint32_t>(
+                           result->GetInt());
+                     } else if (result.has_value() && result->is_double()) {
+                       tokens = base::saturated_cast<uint32_t>(
+                           result->GetDouble());
+                     }
+                     std::move(callback).Run(tokens);
+                   },
+                   std::move(callback)));
+}
+
+}  // namespace
+
+void BindAIManager(mojo::PendingReceiver<blink::mojom::AIManager> receiver) {
+  BuiltInAIManagerImpl::Get().Bind(std::move(receiver));
+}
+
+void AppendBlinkFeatures(base::CommandLine& command_line) {
+  // Must match `switches::kEnableBlinkFeatures`.
+  constexpr char kSwitch[] = "enable-blink-features";
+  constexpr char kFeatures[] = "AIPromptAPI,AIPromptAPIMultimodalInput";
+  std::string value = command_line.GetSwitchValueASCII(kSwitch);
+  command_line.AppendSwitchASCII(
+      kSwitch, value.empty() ? kFeatures : base::StrCat({value, ",", kFeatures}));
+}
+
+}  // namespace built_in_ai
