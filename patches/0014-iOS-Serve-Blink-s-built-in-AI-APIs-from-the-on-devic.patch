@@ -0,0 +1,123 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "ios/chrome/browser/built_in_ai/model/blink/engine_client.h"
+
+#import <atomic>
+#import <utility>
+
+#import "base/functional/bind.h"
+#import "base/json/json_reader.h"
+#import "base/json/json_writer.h"
+#import "base/strings/strcat.h"
+#import "base/strings/string_number_conversions.h"
+#import "base/strings/sys_string_conversions.h"
+#import "base/task/bind_post_task.h"
+#import "base/task/sequenced_task_runner.h"
+#import "ios/chrome/browser/built_in_ai/model/engine_swift.h"
+
+namespace built_in_ai {
+
+namespace {
+
+// Engine clients are keyed by name; every EngineClient gets its own.
+std::string NextClientName() {
+  static std::atomic<int> next{0};
+  return base::StrCat({"blink:", base::NumberToString(++next)});
+}
+
+}  // namespace
+
+EngineClient::Request::Request() = default;
+EngineClient::Request::Request(Request&&) = default;
+EngineClient::Request& EngineClient::Request::operator=(Request&&) = default;
+EngineClient::Request::~Request() = default;
+
+EngineClient::EngineClient() : client_(NextClientName()) {}
+
+EngineClient::~EngineClient() {
+  [[BuiltInAIEngine sharedEngine]
+      releaseClient:base::SysUTF8ToNSString(client_)];
+}
+
+std::string EngineClient::Call(std::string_view cmd,
+                               base::DictValue body,
+                               DoneCallback done,
+                               ChunkCallback on_chunk,
+                               ProgressCallback on_progress) {
+  std::string id = base::NumberToString(++next_id_);
+  Request request;
+  request.done = std::move(done);
+  request.on_chunk = std::move(on_chunk);
+  request.on_progress = std::move(on_progress);
+  requests_.emplace(id, std::move(request));
+  Send(cmd, id, std::move(body));
+  return id;
+}
+
+void EngineClient::Notify(std::string_view cmd, base::DictValue body) {
+  Send(cmd, base::StrCat({"n", base::NumberToString(++next_id_)}),
+       std::move(body));
+}
+
+void EngineClient::Send(std::string_view cmd,
+                        const std::string& id,
+                        base::DictValue body) {
+  body.Set("id", id);
+  body.Set("cmd", cmd);
+  std::string json = base::WriteJson(body).value_or("{}");
+  // The engine answers on its own threads.
+  auto deliver = base::BindPostTask(
+      base::SequencedTaskRunner::GetCurrentDefault(),
+      base::BindRepeating(&EngineClient::OnEvent, weak_factory_.GetWeakPtr()));
+  [[BuiltInAIEngine sharedEngine]
+      handleMessage:base::SysUTF8ToNSString(json)
+             client:base::SysUTF8ToNSString(client_)
+               emit:^(NSString* event) {
+                 deliver.Run(base::SysNSStringToUTF8(event));
+               }];
+}
+
+void EngineClient::OnEvent(const std::string& json) {
+  std::optional<base::DictValue> event = base::JSONReader::ReadDict(
+      json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (!event) {
+    return;
+  }
+  const std::string* id = event->FindString("id");
+  const std::string* type = event->FindString("type");
+  if (!id || !type) {
+    return;
+  }
+  auto it = requests_.find(*id);
+  if (it == requests_.end()) {
+    return;
+  }
+  Request& request = it->second;
+  if (*type == "chunk") {
+    if (const std::string* text = event->FindString("text");
+        text && request.on_chunk) {
+      request.on_chunk.Run(*text);
+    }
+  } else if (*type == "progress") {
+    if (std::optional<double> loaded = event->FindDouble("loaded");
+        loaded && request.on_progress) {
+      request.on_progress.Run(*loaded);
+    }
+  } else if (*type == "result" || *type == "error") {
+    DoneCallback done = std::move(request.done);
+    requests_.erase(it);
+    if (*type == "result") {
+      base::Value* value = event->Find("value");
+      std::move(done).Run(value ? std::move(*value) : base::Value());
+    } else {
+      const std::string* name = event->FindString("name");
+      const std::string* message = event->FindString("message");
+      std::move(done).Run(base::unexpected(
+          Error{name ? *name : "UnknownError", message ? *message : ""}));
+    }
+  }
+}
+
+}  // namespace built_in_ai
