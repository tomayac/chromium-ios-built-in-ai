+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef IOS_CHROME_BROWSER_BUILT_IN_AI_MODEL_BLINK_ENGINE_CLIENT_H_
+#define IOS_CHROME_BROWSER_BUILT_IN_AI_MODEL_BLINK_ENGINE_CLIENT_H_
+
+#include <map>
+#include <string>
+#include <string_view>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/types/expected.h"
+#include "base/values.h"
+
+namespace built_in_ai {
+
+// Talks to the on-device model engine (`BuiltInAIEngine`, in Swift) with the
+// JSON messages the polyfill's native backend sends, and delivers its answers
+// on the sequence that created the client. The engine sessions a client
+// creates belong to it, and the engine drops them when the client goes away.
+class EngineClient {
+ public:
+  // An engine failure, as the name and message of a DOMException.
+  struct Error {
+    std::string name;
+    std::string message;
+  };
+  using DoneCallback =
+      base::OnceCallback<void(base::expected<base::Value, Error>)>;
+  using ChunkCallback = base::RepeatingCallback<void(const std::string& text)>;
+  using ProgressCallback = base::RepeatingCallback<void(double loaded)>;
+
+  EngineClient();
+  EngineClient(const EngineClient&) = delete;
+  EngineClient& operator=(const EngineClient&) = delete;
+  ~EngineClient();
+
+  // Sends `cmd` with `body`, and calls `done` with its result. Returns the
+  // request's ID, which an `abort` names.
+  std::string Call(std::string_view cmd,
+                   base::DictValue body,
+                   DoneCallback done,
+                   ChunkCallback on_chunk = {},
+                   ProgressCallback on_progress = {});
+
+  // Sends `cmd` with `body`, not waiting for an answer.
+  void Notify(std::string_view cmd, base::DictValue body);
+
+ private:
+  struct Request {
+    Request();
+    Request(Request&&);
+    Request& operator=(Request&&);
+    ~Request();
+
+    DoneCallback done;
+    ChunkCallback on_chunk;
+    ProgressCallback on_progress;
+  };
+
+  void Send(std::string_view cmd, const std::string& id, base::DictValue body);
+  void OnEvent(const std::string& json);
+
+  const std::string client_;
+  int next_id_ = 0;
+  std::map<std::string, Request> requests_;
+  base::WeakPtrFactory<EngineClient> weak_factory_{this};
+};
+
+}  // namespace built_in_ai
+
+#endif  // IOS_CHROME_BROWSER_BUILT_IN_AI_MODEL_BLINK_ENGINE_CLIENT_H_
diff --git a/ios/chrome/browser/built_in_ai/model/blink/engine_client.mm b/ios/chrome/browser/built_in_ai/model/blink/engine_client.mm
new file mode 100644
