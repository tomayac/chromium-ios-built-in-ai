     }
 
@@ -1048,9 +1058,11 @@ final class GemmaModelStore: @unchecked Sendable {
   )!
   /// Context window for Gemma sessions. The KV cache grows with it.
   static let contextWindow = 4096
-  /// Gemma 4 E2B runs in about 0.6 GB on the CPU and 1.5 GB on the GPU, on top
-  /// of its memory-mapped embeddings. 4 GB devices use the CPU.
+  /// Gemma 4 E2B takes about 0.6 GB of footprint on the CPU and 1.2 GB on the
