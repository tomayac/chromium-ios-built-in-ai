From 803ad0736a22ed8c2e0ab3880e359e6132ae3007 Mon Sep 17 00:00:00 2001
From: Thomas Steiner <tomac@chromium.org>
Date: Tue, 20 Oct 2026 16:32:21 +0200
Subject: [PATCH 11/13] [iOS] Add a name and icon for builds with the built-in
 AI APIs

Builds distributed to testers through TestFlight and AltStore should
carry neither Chromium's name nor its logo. `ios_chrome_display_name`
sets the name under the Home Screen icon without renaming the bundle,
and the `built_in_ai_icons` asset catalog holds a generic browser icon
with the words "Built-In AI". `no_icons` fills the legacy icon slot.
---
 ios/build/chrome_build.gni                     |   4 ++++
 ios/chrome/app/BUILD.gn                        |   6 ++++++
 ios/chrome/app/resources/BUILD.gn              |  16 ++++++++++++++++
 .../AppIcon.appiconset/Contents.json           |  14 ++++++++++++++
 .../AppIcon.appiconset/Icon-1024.png           | Bin 0 -> 160890 bytes
 .../BuiltInAIIcons.xcassets/Contents.json      |   6 ++++++
 ios/chrome/app/resources/Info.plist            |   2 +-
 7 files changed, 47 insertions(+), 1 deletion(-)
 create mode 100644 ios/chrome/app/resources/BuiltInAIIcons.xcassets/AppIcon.appiconset/Contents.json
 create mode 100644 ios/chrome/app/resources/BuiltInAIIcons.xcassets/AppIcon.appiconset/Icon-1024.png
 create mode 100644 ios/chrome/app/resources/BuiltInAIIcons.xcassets/Contents.json

diff --git a/ios/build/chrome_build.gni b/ios/build/chrome_build.gni
index 43103d0a2055d..7688bf8c3cccb 100644
--- a/ios/build/chrome_build.gni
+++ b/ios/build/chrome_build.gni
@@ -35,6 +35,10 @@ declare_args() {
   # virtual addressing, which PartitionAlloc then copes without.
   ios_chrome_sideload_entitlements = false
 
+  # The name under the app's icon on the Home Screen, when it should differ
+  # from `chromium_short_name`, which also names the bundle.
+  ios_chrome_display_name = ""
+
   # Enable share extension.
   ios_enable_share_extension = true
 
diff --git a/ios/chrome/app/BUILD.gn b/ios/chrome/app/BUILD.gn
index bd6690f5e6d6d..186923f14d275 100644
--- a/ios/chrome/app/BUILD.gn
+++ b/ios/chrome/app/BUILD.gn
@@ -898,6 +898,11 @@ ios_framework_bundle("early_partition_alloc_framework") {
   ]
 }
 
+_display_name = chromium_short_name
+if (ios_chrome_display_name != "") {
+  _display_name = ios_chrome_display_name
+}
+
 chrome_app("chrome") {
   output_name = chromium_short_name
 
@@ -989,6 +994,7 @@ chrome_app("chrome") {
     "CHROMIUM_BUNDLE_ID=$ios_chromium_bundle_id",
     "CHROMIUM_HANDOFF_ID=$chromium_handoff_id",
     "CHROMIUM_SHORT_NAME=$chromium_short_name",
+    "CHROMIUM_DISPLAY_NAME=$_display_name",
     "CHROMIUM_URL_SCHEME_1=$url_unsecure_scheme",
     "CHROMIUM_URL_SCHEME_2=$url_secure_scheme",
     "CHROMIUM_URL_SCHEME_3=$url_x_callback_scheme",
diff --git a/ios/chrome/app/resources/BUILD.gn b/ios/chrome/app/resources/BUILD.gn
index 96fc21d7f91d7..c6d29a1e93263 100644
--- a/ios/chrome/app/resources/BUILD.gn
+++ b/ios/chrome/app/resources/BUILD.gn
@@ -184,6 +184,22 @@ bundle_data_xcassets("chromium_icons") {
   ]
 }
 
+# A generic browser icon with the words "Built-In AI", for builds that
+# distribute Chromium with the built-in AI APIs under a name of their own. Set
+# `ios_application_icons_target` to this target, and
+# `ios_application_icons_target_legacy` to `:no_icons`.
+bundle_data_xcassets("built_in_ai_icons") {
+  catalog = "BuiltInAIIcons.xcassets"
+  sources = [
+    "BuiltInAIIcons.xcassets/AppIcon.appiconset/Contents.json",
+    "BuiltInAIIcons.xcassets/AppIcon.appiconset/Icon-1024.png",
+    "BuiltInAIIcons.xcassets/Contents.json",
+  ]
+}
+
+group("no_icons") {
+}
+
 bundle_data_xcassets("launchscreen_assets") {
   catalog = "Launchscreen.xcassets"
   sources = [
diff --git a/ios/chrome/app/resources/BuiltInAIIcons.xcassets/AppIcon.appiconset/Contents.json b/ios/chrome/app/resources/BuiltInAIIcons.xcassets/AppIcon.appiconset/Contents.json
new file mode 100644
index 0000000000000..82f5bf1024b75
--- /dev/null
+++ b/ios/chrome/app/resources/BuiltInAIIcons.xcassets/AppIcon.appiconset/Contents.json
@@ -0,0 +1,14 @@
+{
+  "images" : [
+    {
+      "filename" : "Icon-1024.png",
+      "idiom" : "universal",
+      "platform" : "ios",
+      "size" : "1024x1024"
+    }
+  ],
+  "info" : {
+    "author" : "xcode",
+    "version" : 1
+  }
+}
diff --git a/ios/chrome/app/resources/BuiltInAIIcons.xcassets/AppIcon.appiconset/Icon-1024.png b/ios/chrome/app/resources/BuiltInAIIcons.xcassets/AppIcon.appiconset/Icon-1024.png
new file mode 100644
index 0000000000000000000000000000000000000000..eff00050d160784033b265b22d75fdef62028f31
GIT binary patch
