+    /// The backend the model runs on: the GPU where it computes correctly and
+    /// the app has the memory for it, the CPU otherwise. Developers can
+    /// override it with launch arguments, `-BuiltInAIGemmaBackend
+    /// cpu|gpu|auto` and `-BuiltInAIGemmaThreads <n>`, which end up in the
+    /// argument domain of the user defaults.
+    static var backend: Backend {
+      let defaults = UserDefaults.standard
+      let threads = defaults.integer(forKey: "BuiltInAIGemmaThreads")
+      let cpu: Backend = .cpu(threadCount: threads > 0 ? threads : nil)
+      switch defaults.string(forKey: "BuiltInAIGemmaBackend") {
+      case "cpu": return cpu
+      case "gpu": return .gpu
+      default: return gpuIsSupported && hasRoomForGPU ? .gpu : cpu
+      }
+    }
+
+    /// The precision of the activations, the engine's default unless a developer
+    /// overrides it with `-BuiltInAIGemmaActivation f16|f32`.
+    static var activationDataType: ActivationDataType? {
+      switch UserDefaults.standard.string(forKey: "BuiltInAIGemmaActivation") {
+      case "f16": return .float16
+      case "f32": return .float32
+      default: return nil
+      }
+    }
+
+    /// Whether LiteRT-LM's Metal backend computes Gemma correctly on this GPU.
+    ///
+    /// On an A13 (Apple GPU family 6, iPhone 11 Pro Max) it runs at 20 tokens
+    /// per second and produces random tokens, with 16-bit and 32-bit
+    /// activations alike, while the CPU answers correctly at 14 tokens per
+    /// second. The model card measures the GPU on an A19 Pro, and it is correct
+    /// on M-series Macs, so family 7 (A14) and later are taken to work.
+    static var gpuIsSupported: Bool {
+      #if canImport(Metal)
+        return MTLCreateSystemDefaultDevice()?.supportsFamily(.apple7) ?? false
+      #else
+        return false
+      #endif
+    }
+
+    /// What the GPU backend needs on top of what the app already uses, with a
+    /// margin for the pages that keep running next to it.
+    static let gpuMemoryNeeded: UInt64 = 1_500_000_000
+
+    /// Whether loading the model on the GPU leaves the app safely below the
+    /// limit iOS kills it at.
+    static var hasRoomForGPU: Bool {
+      #if os(iOS)
+        // How far the app is from that limit. It counts the increased memory
+        // limit entitlement, and what the app uses already.
+        return UInt64(os_proc_available_memory()) >= gpuMemoryNeeded
+      #else
+        return ProcessInfo.processInfo.physicalMemory >= GemmaModelStore.gpuPhysicalMemory
+      #endif
+    }
+
     private static func load() async throws -> Engine {
-      let useGPU = ProcessInfo.processInfo.physicalMemory >= GemmaModelStore.gpuPhysicalMemory
-      let backend: Backend = useGPU ? .gpu : .cpu()
+      let backend = Self.backend
+      loadedBackend = backend
       let caches = FileManager.default.urls(for: .cachesDirectory, in: .userDomainMask)[0]
         .appendingPathComponent("BuiltInAI", isDirectory: true)
       try FileManager.default.createDirectory(at: caches, withIntermediateDirectories: true)
@@ -1240,13 +1315,81 @@ final class GemmaModelStore: @unchecked Sendable {
         engineConfig: try EngineConfig(
           modelPath: GemmaModelStore.shared.modelURL.path, backend: backend,
           visionBackend: backend, audioBackend: .cpu(),
-          maxNumTokens: GemmaModelStore.contextWindow, cacheDir: caches.path))
+          maxNumTokens: GemmaModelStore.contextWindow, cacheDir: caches.path,
+          activationDataType: activationDataType))
       try await engine.initialize()
       return engine
     }
   }
 #endif
 
+#if canImport(LiteRTLM)
+  /// Records how fast Gemma runs, one JSON line per answer, in
+  /// `Library/Caches/BuiltInAI/stats.jsonl` of the app's container, for
+  /// developers to compare backends and settings on real devices.
+  enum GemmaStats {
+    static func record(
+      started: Date, firstChunk: Date?, lastChunk: Date, chunks: Int, contextTokens: Int,
+      sample: String
+    ) {
+      var entry: [String: Any] = [
+        "time": ISO8601DateFormatter().string(from: started),
+        "backend": (GemmaRuntime.loadedBackend ?? GemmaRuntime.backend).rawValue,
+        "threads": UserDefaults.standard.integer(forKey: "BuiltInAIGemmaThreads"),
+        "activation": UserDefaults.standard.string(forKey: "BuiltInAIGemmaActivation") ?? "default",
+        "chunks": chunks,
+        "contextTokens": contextTokens,
+        // The start of the answer, to tell real text from numeric garbage.
+        "sample": sample,
+        "physicalMemoryMB": ProcessInfo.processInfo.physicalMemory >> 20,
+      ]
+      if let firstChunk {
+        entry["timeToFirstChunkMs"] = Int(firstChunk.timeIntervalSince(started) * 1000)
+        let decode = lastChunk.timeIntervalSince(firstChunk)
+        if chunks > 1, decode > 0 {
+          // LiteRT-LM streams one token per chunk.
+          entry["decodeTokensPerSecond"] = (Double(chunks - 1) / decode * 10).rounded() / 10
+        }
+      }
+      if let footprint = MemoryFootprint.current() {
+        entry["footprintMB"] = footprint.now >> 20
+        entry["peakFootprintMB"] = footprint.peak >> 20
+      }
+      if #available(iOS 13.0, *) {
+        entry["availableMemoryMB"] = os_proc_available_memory() >> 20
+      }
+      let caches = FileManager.default.urls(for: .cachesDirectory, in: .userDomainMask)[0]
+        .appendingPathComponent("BuiltInAI/stats.jsonl")
+      guard var line = try? JSONSerialization.data(withJSONObject: entry, options: [.sortedKeys])
+      else { return }
+      line.append(0x0A)
+      if let handle = try? FileHandle(forWritingTo: caches) {
+        _ = try? handle.seekToEnd()
+        try? handle.write(contentsOf: line)
+        try? handle.close()
+      } else {
+        try? line.write(to: caches)
+      }
+    }
+  }
+
+  /// The memory iOS charges this app for, which is what it kills apps over.
+  enum MemoryFootprint {
+    static func current() -> (now: UInt64, peak: UInt64)? {
+      var info = task_vm_info_data_t()
+      var count = mach_msg_type_number_t(
+        MemoryLayout<task_vm_info_data_t>.size / MemoryLayout<natural_t>.size)
+      let result = withUnsafeMutablePointer(to: &info) {
+        $0.withMemoryRebound(to: integer_t.self, capacity: Int(count)) {
+          task_info(mach_task_self_, task_flavor_t(TASK_VM_INFO), $0, &count)
+        }
+      }
+      guard result == KERN_SUCCESS else { return nil }
+      return (info.phys_footprint, UInt64(max(0, info.ledger_phys_footprint_peak)))
+    }
+  }
+#endif
+
