+/// How one session runs Gemma.
+struct GemmaPlan: Hashable, Sendable {
+  let file: GemmaFile
+  let onGPU: Bool
+  /// CPU threads; nil for LiteRT-LM's default.
+  let threads: Int?
+  /// "f16" or "f32"; nil for LiteRT-LM's default, which is 16-bit on the GPU.
+  let activation: String?
+}
+
+/// Picks the Gemma file, backend, and precision for a session.
+///
+/// What the session needs to read comes from its `expectedInputs`, which the
+/// Prompt API fixes at `create()`. What works where was measured and reported:
+///
+/// | GPU family       | Multimodal file on the GPU                         |
+/// | ---------------- | -------------------------------------------------- |
+/// | 6 (A13)          | random tokens, at 16 and 32 bits (measured)        |
+/// | 7 (A14, M1)      | digits slip at 16 bits, also in short contexts     |
+/// | 8 (A15, A16, M2) | correct, digits slip at 16 bits in long contexts   |
+/// | 9, 10 (M4, A19)  | correct below 2,048 tokens                         |
+///
+/// The text-only GPU file runs correctly on family 6: 21 tokens per second and
+/// 0.4 GB of footprint on an iPhone 11 Pro Max, against 14 tokens per second
+/// for the multimodal file on its CPU. Reports: LiteRT-LM issues 2814 and
+/// 3913. Families 5 and older are untested on the GPU and use the CPU.
+enum GemmaPlanner {
+  static func plan(for requirements: ModelRequirements) -> GemmaPlan? {
+    guard GemmaModelStore.isSupported else { return nil }
+    let defaults = UserDefaults.standard
+    let threads = defaults.integer(forKey: "BuiltInAIGemmaThreads")
+    let activationOverride = defaults.string(forKey: "BuiltInAIGemmaActivation").flatMap {
+      ["f16", "f32"].contains($0) ? $0 : nil
+    }
+    let backendOverride = defaults.string(forKey: "BuiltInAIGemmaBackend")
+    let needsMedia = !requirements.inputTypes.isSubset(of: ["text"])
+    let family = gpuFamily
+    let store = GemmaModelStore.shared
+
+    var file: GemmaFile
+    var onGPU: Bool
+    if let name = fileOverride {
+      file = .named(name)
+      onGPU =
+        backendOverride == "gpu" || !file.runsOnCPU
+        || (backendOverride != "cpu" && family >= 7 && hasRoom(for: file))
+    } else if backendOverride == "cpu" {
+      (file, onGPU) = (.multimodal, false)
+    } else if needsMedia {
+      onGPU = backendOverride == "gpu" || (family >= 7 && hasRoom(for: .multimodal))
+      file = .multimodal
+    } else if backendOverride == "gpu" || (family >= 6 && hasRoom(for: .text)) {
+      // On GPUs that run the multimodal file, it serves text, too, rather than
+      // making a page wait for a second download.
+      let reuse =
+        family >= 7 && store.isPresent(.multimodal) && !store.isPresent(.text)
+        && hasRoom(for: .multimodal)
+      (file, onGPU) = (reuse ? .multimodal : .text, true)
+    } else {
+      (file, onGPU) = (.multimodal, false)
+    }
+    if needsMedia, !file.isMultimodal { return nil }
+    if !onGPU, !file.runsOnCPU { return nil }
+
+    // 32 bits where 16 corrupts digits even in short contexts.
+    let activation = activationOverride ?? (onGPU && file.isMultimodal && family == 7 ? "f32" : nil)
+    return GemmaPlan(
+      file: file, onGPU: onGPU, threads: onGPU || threads <= 0 ? nil : threads,
+      activation: activation)
+  }
+
+  /// `-BuiltInAIGemmaModelFile <name>`, a plain file name of the repo.
+  static var fileOverride: String? {
+    let name = UserDefaults.standard.string(forKey: "BuiltInAIGemmaModelFile") ?? ""
+    return !name.isEmpty && !name.contains("/") && !name.hasPrefix(".") ? name : nil
+  }
+
+  /// The Apple GPU family, 0 where there is none or it is unknown.
+  static let gpuFamily: Int = {
+    #if canImport(Metal)
+      guard let device = MTLCreateSystemDefaultDevice() else { return 0 }
+      let families: [(MTLGPUFamily, Int)] = [
+        (.apple9, 9), (.apple8, 8), (.apple7, 7), (.apple6, 6), (.apple5, 5),
+        (.apple4, 4), (.apple3, 3), (.apple2, 2), (.apple1, 1),
+      ]
+      if #available(iOS 26.0, macOS 26.0, *), device.supportsFamily(.apple10) { return 10 }
+      return families.first { device.supportsFamily($0.0) }?.1 ?? 0
+    #else
+      return 0
+    #endif
+  }()
+
+  /// Whether loading `file` on the GPU leaves the app safely below the limit
+  /// iOS kills it at.
+  static func hasRoom(for file: GemmaFile) -> Bool {
+    #if os(iOS)
+      // How far the app is from that limit. It counts the increased memory
+      // limit entitlement, and what the app uses already.
+      return UInt64(os_proc_available_memory()) >= file.gpuMemoryNeeded
+    #else
+      return ProcessInfo.processInfo.physicalMemory >= GemmaModelStore.gpuPhysicalMemory
+    #endif
+  }
+}
