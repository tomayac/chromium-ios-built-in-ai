+#if canImport(LiteRTLM)
+  /// A LiteRT-LM session that applies no prompt template: it decodes from
+  /// exactly the text it is given. Conversations cannot continue a model turn
+  /// that is underway, which this can.
+  final class RawGemmaSession: @unchecked Sendable {
+    private let handle: OpaquePointer
+    /// The engine the session runs on, kept for as long as the session.
+    var owner: Engine?
+
+    init(engine: OpaquePointer, topK: Int, topP: Float, temperature: Float) throws {
+      guard let config = litert_lm_session_config_create() else {
+        throw BuiltInAIError.operation("Gemma could not configure a session.")
+      }
+      defer { litert_lm_session_config_delete(config) }
+      litert_lm_session_config_set_apply_prompt_template(config, false)
+      if let params = litert_lm_sampler_params_create(kLiteRtLmSamplerTypeTopP) {
+        litert_lm_sampler_params_set_top_k(params, Int32(topK))
+        litert_lm_sampler_params_set_top_p(params, topP)
+        litert_lm_sampler_params_set_temperature(params, temperature)
+        litert_lm_session_config_set_sampler_params(config, params)
+        litert_lm_sampler_params_delete(params)
+      }
+      guard let handle = litert_lm_engine_create_session(engine, config) else {
+        throw BuiltInAIError.operation("Gemma could not start a session.")
+      }
+      self.handle = handle
+    }
+
+    deinit {
+      litert_lm_session_delete(handle)
+    }
+
+    func cancel() {
+      litert_lm_session_cancel_process(handle)
+    }
+
+    /// Streams the text that follows `prompt`.
+    func generate(_ prompt: String) throws -> AsyncThrowingStream<String, Error> {
+      let (stream, continuation) = AsyncThrowingStream<String, Error>.makeStream()
+      let utf8 = Array(prompt.utf8)
+      guard
+        let input = utf8.withUnsafeBytes({ bytes in
+          litert_lm_input_data_create(kLiteRtLmInputDataTypeText, bytes.baseAddress, bytes.count)
+        })
+      else {
+        throw BuiltInAIError.operation("Gemma could not take the prompt.")
+      }
+      // Holds the input and this session until the last chunk.
+      let context = Unmanaged.passRetained(
+        RawStreamContext(continuation: continuation, input: input, session: self)
+      ).toOpaque()
+      let inputs: [OpaquePointer?] = [input]
+      let status = inputs.withUnsafeBufferPointer { buffer in
+        litert_lm_session_generate_content_stream(
+          handle, buffer.baseAddress, 1, rawStreamCallback, context)
+      }
+      if status != 0 {
+        Unmanaged<RawStreamContext>.fromOpaque(context).release()
+        throw BuiltInAIError.operation("Gemma could not start decoding (\(status)).")
+      }
+      return stream
+    }
+  }
+
+  final class RawStreamContext {
+    let continuation: AsyncThrowingStream<String, Error>.Continuation
+    let input: OpaquePointer
+    let session: RawGemmaSession
+
+    init(
+      continuation: AsyncThrowingStream<String, Error>.Continuation, input: OpaquePointer,
+      session: RawGemmaSession
+    ) {
+      self.continuation = continuation
+      self.input = input
+      self.session = session
+    }
+
+    deinit {
+      litert_lm_input_data_delete(input)
+    }
+  }
+
+  private func rawStreamCallback(userData: UnsafeMutableRawPointer?, chunk: OpaquePointer?) {
+    guard let userData else { return }
+    let context = Unmanaged<RawStreamContext>.fromOpaque(userData).takeUnretainedValue()
+    if let error = litert_lm_stream_chunk_get_error(chunk) {
+      context.continuation.finish(
+        throwing: BuiltInAIError.operation("Gemma: \(String(cString: error))"))
+      Unmanaged<RawStreamContext>.fromOpaque(userData).release()
+      return
+    }
+    if let text = litert_lm_stream_chunk_get_text(chunk) {
+      context.continuation.yield(String(cString: text))
+    }
+    if litert_lm_stream_chunk_is_final(chunk) {
+      context.continuation.finish()
+      Unmanaged<RawStreamContext>.fromOpaque(userData).release()
+    }
+  }
+#endif
+
 #if canImport(LiteRTLM)
   /// Lets one Gemma turn run at a time, preferring turns for the engine that
   /// is loaded, so that pages needing different engines do not make it reload
