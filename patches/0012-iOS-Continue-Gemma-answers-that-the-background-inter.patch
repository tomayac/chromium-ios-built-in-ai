+    /// Goes on with an answer that the background interrupted after `partial`.
+    ///
+    /// Conversations only take whole turns, so this renders the conversation
+    /// into Gemma's prompt format itself, with the model's turn left open
+    /// after `partial`, and decodes from there in a session that applies no
+    /// template of its own.
+    private func liteRTContinuation(
+      plan: GemmaPlan, messages: [ChatMessage], contents: ChatContents, partial: String,
+      onChunk: @escaping @Sendable (String) -> Void, backgrounds: Int
+    ) async throws -> GenerationOutput {
+      let runtime = GemmaRuntime.shared
+      let (engine, _) = try await runtime.engine(for: plan)
+      if plan.onGPU, runtime.backgroundCount != backgrounds || runtime.isInBackground {
+        throw GemmaInterruption()
+      }
+      let prompt = try await Self.openTurnPrompt(
+        engine: engine, system: systemText(contents.messages), messages: messages,
+        partial: partial)
+      let sampler = try liteRTSampler(structured: false)
+      let (topK, topP, temperature) = (sampler.topK, sampler.topP, sampler.temperature)
+      let session = try await engine.withNativeHandle { handle in
+        try RawGemmaSession(engine: handle, topK: topK, topP: topP, temperature: temperature)
+      }
+      // An eviction meanwhile drops the runtime's reference to the engine, and
+      // the session must not outlive it.
+      session.owner = engine
+
+      var text = ""
+      let started = Date()
+      var firstChunk: Date?
+      var lastChunk = started
+      var chunks = 0
+      let watcher: Task<Void, Never>? =
+        plan.onGPU
+        ? Task {
+          await runtime.waitForBackground(after: backgrounds)
+          if !Task.isCancelled { session.cancel() }
+        } : nil
+      defer { watcher?.cancel() }
+      try await withTaskCancellationHandler {
+        for try await delta in try session.generate(prompt) {
+          try Task.checkCancellation()
+          if delta.isEmpty { continue }
+          chunks += 1
+          lastChunk = Date()
+          if firstChunk == nil { firstChunk = lastChunk }
+          text += delta
+          onChunk(delta)
+        }
+      } onCancel: {
+        session.cancel()
+      }
+      if plan.onGPU, runtime.backgroundCount != backgrounds { throw GemmaInterruption() }
+      // Tokens of the whole exchange, roughly, since the session counts none.
+      let usage = (prompt.count + text.count + 3) / 4
+      GemmaStats.record(
+        plan: gemmaPlan, started: started, firstChunk: firstChunk, lastChunk: lastChunk,
+        chunks: chunks, contextTokens: usage, sample: String((partial + text).prefix(120)))
+      return GenerationOutput(text: text, usage: usage)
+    }
+
+    /// `messages` in Gemma's prompt format, followed by the start of a model
+    /// turn holding `partial`. Gemma's template only renders messages in the
+    /// context of a whole conversation, so a conversation renders them all as
+    /// its preface, with a model turn holding a marker at the end, and the
+    /// prompt ends where the marker begins.
+    private static func openTurnPrompt(
+      engine: Engine, system: String, messages: [ChatMessage], partial: String
+    ) async throws -> String {
+      let marker = "\u{E000}"
+      let renderer = try await engine.createConversation(
+        with: ConversationConfig(
+          systemMessage: system.isEmpty ? nil : Message(system, role: .system),
+          initialMessages: messages.map(liteRTMessage)
+            + [Message(contents: [.text(marker)], role: .model)],
+          thinkingConfig: ThinkingConfig(enableThinking: false)))
+      let rendered = try renderer.renderPrefaceIntoString()
+      guard let range = rendered.range(of: marker, options: .backwards) else {
+        throw BuiltInAIError.operation("Gemma's prompt format has no place for the answer.")
+      }
+      return rendered[..<range.lowerBound] + partial
+    }
+
