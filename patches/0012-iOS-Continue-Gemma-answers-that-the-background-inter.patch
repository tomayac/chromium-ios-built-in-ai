+
+// Appended to Engine.swift by fetch.py, since it needs the engine's private
+// `handle`.
+
+extension Engine {
+  /// Runs `body` with the native engine on the engine's actor, for C API calls
+  /// that the Swift API does not wrap, such as sessions without the prompt
+  /// template.
+  public func withNativeHandle<T: Sendable>(
+    _ body: @Sendable (OpaquePointer) throws -> T
+  ) throws -> T {
+    guard let handle else {
+      throw LiteRTLMError.engine(.notInitialized)
+    }
+    return try body(handle)
+  }
+}
