+#ifndef IOS_CHROME_BROWSER_BUILT_IN_AI_MODEL_BUILT_IN_AI_TAB_HELPER_H_
+#define IOS_CHROME_BROWSER_BUILT_IN_AI_MODEL_BUILT_IN_AI_TAB_HELPER_H_
+
+#import <set>
+#import <string>
+
+#import "base/memory/raw_ptr.h"
+#import "base/scoped_observation.h"
+#import "ios/web/public/js_messaging/web_frames_manager.h"
+#import "ios/web/public/web_state_observer.h"
+#import "ios/web/public/web_state_user_data.h"
+
+// Destroys the model sessions of a frame when the frame goes away, and those
+// of the whole tab when the tab does. Created on the first built-in AI call of
+// a tab.
+class BuiltInAITabHelper
+    : public web::WebStateUserData<BuiltInAITabHelper>,
+      public web::WebStateObserver,
+      public web::WebFramesManager::Observer {
+ public:
+  ~BuiltInAITabHelper() override;
+
+  BuiltInAITabHelper(const BuiltInAITabHelper&) = delete;
+  BuiltInAITabHelper& operator=(const BuiltInAITabHelper&) = delete;
+
+  // Notes that the frame `frame_id` has sessions.
+  void TrackFrame(const std::string& frame_id);
+
+  // web::WebFramesManager::Observer:
+  void WebFrameBecameUnavailable(web::WebFramesManager* web_frames_manager,
+                                 const std::string& frame_id) override;
+
+  // web::WebStateObserver:
+  void WebStateDestroyed(web::WebState* web_state) override;
+
+ private:
+  friend class web::WebStateUserData<BuiltInAITabHelper>;
+
+  explicit BuiltInAITabHelper(web::WebState* web_state);
+
+  void Release(const std::string& frame_id);
+
+  raw_ptr<web::WebState> web_state_;
+  std::set<std::string> frame_ids_;
+  base::ScopedObservation<web::WebState, web::WebStateObserver>
+      web_state_observation_{this};
+  base::ScopedObservation<web::WebFramesManager,
+                          web::WebFramesManager::Observer>
+      frames_observation_{this};
+};
+
+#endif  // IOS_CHROME_BROWSER_BUILT_IN_AI_MODEL_BUILT_IN_AI_TAB_HELPER_H_
diff --git a/ios/chrome/browser/built_in_ai/model/built_in_ai_tab_helper.mm b/ios/chrome/browser/built_in_ai/model/built_in_ai_tab_helper.mm
