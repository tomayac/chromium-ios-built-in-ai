@@ -0,0 +1,132 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "ios/chrome/browser/built_in_ai/model/built_in_ai_java_script_feature.h"
+
+#import "base/functional/bind.h"
+#import "base/strings/strcat.h"
+#import "base/strings/string_number_conversions.h"
+#import "base/strings/sys_string_conversions.h"
+#import "base/task/bind_post_task.h"
+#import "base/task/sequenced_task_runner.h"
+#import "base/values.h"
+#import "ios/chrome/browser/built_in_ai/model/built_in_ai_engine_swift.h"
+#import "ios/chrome/browser/built_in_ai/model/built_in_ai_tab_helper.h"
+#import "ios/web/public/js_messaging/script_message.h"
+#import "ios/web/public/js_messaging/web_frame.h"
+#import "ios/web/public/js_messaging/web_frames_manager.h"
+#import "ios/web/public/web_state.h"
+
+namespace {
+
+constexpr char kBridgeScriptName[] = "built_in_ai_bridge";
+constexpr char kPolyfillsScriptName[] = "built_in_ai_polyfills";
+constexpr char kHandlerName[] = "BuiltInAIMessageHandler";
+
+// The gCrWeb function that hands an event to the page.
+constexpr char kDeliverFunction[] = "builtInAI.deliver";
+
+// Sends `event` to the frame `frame_id` of `web_state`, if both still exist.
+void DeliverToFrame(base::WeakPtr<web::WebState> weak_web_state,
+                    const std::string& frame_id,
+                    const std::string& event) {
+  web::WebState* web_state = weak_web_state.get();
+  if (!web_state) {
+    return;
+  }
+  BuiltInAIJavaScriptFeature* feature =
+      BuiltInAIJavaScriptFeature::GetInstance();
+  web::WebFrame* frame =
+      feature->GetWebFramesManager(web_state)->GetFrameWithId(frame_id);
+  if (frame) {
+    feature->Deliver(frame, event);
+  }
+}
+
+}  // namespace
+
+// static
+BuiltInAIJavaScriptFeature* BuiltInAIJavaScriptFeature::GetInstance() {
+  static base::NoDestructor<BuiltInAIJavaScriptFeature> instance;
+  return instance.get();
+}
+
+// static
+std::string BuiltInAIJavaScriptFeature::ClientKey(web::WebState* web_state,
+                                                  const std::string& frame_id) {
+  return base::StrCat(
+      {base::NumberToString(web_state->GetUniqueIdentifier().identifier()),
+       "/", frame_id});
+}
+
+BuiltInAIJavaScriptFeature::BuiltInAIJavaScriptFeature()
+    : JavaScriptFeature(
+          // The APIs are globals of the page, so they live in its world.
+          web::ContentWorld::kPageContentWorld,
+          {
+              // The bridge first: the polyfills look for it.
+              FeatureScript::CreateWithFilename(
+                  kBridgeScriptName,
+                  FeatureScript::InjectionTime::kDocumentStart,
+                  FeatureScript::TargetFrames::kAllFrames,
+                  FeatureScript::ReinjectionBehavior::
+                      kReinjectOnDocumentRecreation),
+              FeatureScript::CreateWithFilename(
+                  kPolyfillsScriptName,
+                  FeatureScript::InjectionTime::kDocumentStart,
+                  FeatureScript::TargetFrames::kAllFrames,
+                  FeatureScript::ReinjectionBehavior::
+                      kReinjectOnDocumentRecreation),
+          }) {}
+
+BuiltInAIJavaScriptFeature::~BuiltInAIJavaScriptFeature() = default;
+
+void BuiltInAIJavaScriptFeature::Deliver(web::WebFrame* frame,
+                                         const std::string& event) {
+  CallJavaScriptFunction(frame, kDeliverFunction,
+                         base::ListValue().Append(event));
+}
+
+std::optional<std::string>
+BuiltInAIJavaScriptFeature::GetScriptMessageHandlerName() const {
+  return kHandlerName;
+}
+
+void BuiltInAIJavaScriptFeature::ScriptMessageReceived(
+    web::WebState* web_state,
+    const web::ScriptMessage& script_message) {
+  if (script_message.body().type() != base::Value::Type::DICT) {
+    return;
+  }
+  const web::ScriptMessageDictValue& body = script_message.body().GetDict();
+  std::optional<std::string> frame_id = body.FindString("frameId");
+  std::optional<std::string> message = body.FindString("message");
+  if (!frame_id || !message) {
+    return;
+  }
+
+  // The page world can claim any frame id. Accept only the frame the message
+  // actually came from, as far as its origin tells.
+  web::WebFrame* frame = GetWebFramesManager(web_state)->GetFrameWithId(*frame_id);
+  if (!frame || !frame->GetSecurityOrigin().IsSameOriginWith(
+                    script_message.security_origin())) {
+    return;
+  }
+
+  // Releases the frame's sessions once it goes away.
+  BuiltInAITabHelper::CreateForWebState(web_state);
+  BuiltInAITabHelper::FromWebState(web_state)->TrackFrame(*frame_id);
+
+  // The engine answers on its own threads. Events go back on this sequence,
+  // and only to a frame that still exists.
+  auto deliver = base::BindPostTask(
+      base::SequencedTaskRunner::GetCurrentDefault(),
+      base::BindRepeating(&DeliverToFrame, web_state->GetWeakPtr(), *frame_id));
+  [[BuiltInAIEngine sharedEngine]
+      handleMessage:base::SysUTF8ToNSString(*message)
+             client:base::SysUTF8ToNSString(ClientKey(web_state, *frame_id))
+               emit:^(NSString* event) {
+                 deliver.Run(base::SysNSStringToUTF8(event));
+               }];
+}
