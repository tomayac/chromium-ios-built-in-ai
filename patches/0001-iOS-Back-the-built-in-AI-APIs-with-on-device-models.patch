+#ifndef IOS_CHROME_BROWSER_BUILT_IN_AI_MODEL_BUILT_IN_AI_JAVA_SCRIPT_FEATURE_H_
+#define IOS_CHROME_BROWSER_BUILT_IN_AI_MODEL_BUILT_IN_AI_JAVA_SCRIPT_FEATURE_H_
+
+#import <optional>
+#import <string>
+
+#import "base/no_destructor.h"
+#import "ios/web/public/js_messaging/java_script_feature.h"
+
+namespace web {
+class WebFrame;
+}  // namespace web
+
+// Injects the built-in AI APIs into every frame, in the page's own world, and
+// carries their calls to the on-device models in `BuiltInAIEngine` and the
+// answers back.
+class BuiltInAIJavaScriptFeature : public web::JavaScriptFeature {
+ public:
+  static BuiltInAIJavaScriptFeature* GetInstance();
+
+  BuiltInAIJavaScriptFeature(const BuiltInAIJavaScriptFeature&) = delete;
+  BuiltInAIJavaScriptFeature& operator=(const BuiltInAIJavaScriptFeature&) =
+      delete;
+
+  // Sends one event, a JSON string, to the page in `frame`.
+  void Deliver(web::WebFrame* frame, const std::string& event);
+
+  // The key that ties the engine's sessions to one frame of one tab.
+  static std::string ClientKey(web::WebState* web_state,
+                               const std::string& frame_id);
+
+ private:
+  friend class base::NoDestructor<BuiltInAIJavaScriptFeature>;
+
+  BuiltInAIJavaScriptFeature();
+  ~BuiltInAIJavaScriptFeature() override;
+
+  // web::JavaScriptFeature:
+  std::optional<std::string> GetScriptMessageHandlerName() const override;
+  void ScriptMessageReceived(web::WebState* web_state,
+                             const web::ScriptMessage& message) override;
+};
+
+#endif  // IOS_CHROME_BROWSER_BUILT_IN_AI_MODEL_BUILT_IN_AI_JAVA_SCRIPT_FEATURE_H_
diff --git a/ios/chrome/browser/built_in_ai/model/built_in_ai_java_script_feature.mm b/ios/chrome/browser/built_in_ai/model/built_in_ai_java_script_feature.mm
