--- /dev/null
+++ b/ios/chrome/browser/built_in_ai/model/built_in_ai_tab_helper.mm
@@ -0,0 +1,48 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "ios/chrome/browser/built_in_ai/model/built_in_ai_tab_helper.h"
+
+#import "base/strings/sys_string_conversions.h"
+#import "ios/chrome/browser/built_in_ai/model/built_in_ai_engine_swift.h"
+#import "ios/chrome/browser/built_in_ai/model/built_in_ai_java_script_feature.h"
+
+BuiltInAITabHelper::BuiltInAITabHelper(web::WebState* web_state)
+    : web_state_(web_state) {
+  web_state_observation_.Observe(web_state);
+  frames_observation_.Observe(
+      BuiltInAIJavaScriptFeature::GetInstance()->GetWebFramesManager(
+          web_state));
+}
+
+BuiltInAITabHelper::~BuiltInAITabHelper() = default;
+
+void BuiltInAITabHelper::TrackFrame(const std::string& frame_id) {
+  frame_ids_.insert(frame_id);
+}
+
+void BuiltInAITabHelper::WebFrameBecameUnavailable(
+    web::WebFramesManager* web_frames_manager,
+    const std::string& frame_id) {
+  if (frame_ids_.erase(frame_id)) {
+    Release(frame_id);
+  }
+}
+
+void BuiltInAITabHelper::WebStateDestroyed(web::WebState* web_state) {
+  for (const std::string& frame_id : frame_ids_) {
+    Release(frame_id);
+  }
+  frame_ids_.clear();
+  frames_observation_.Reset();
+  web_state_observation_.Reset();
+  web_state_ = nullptr;
+}
+
+void BuiltInAITabHelper::Release(const std::string& frame_id) {
+  [[BuiltInAIEngine sharedEngine]
+      releaseClient:base::SysUTF8ToNSString(
+                        BuiltInAIJavaScriptFeature::ClientKey(web_state_,
+                                                              frame_id))];
+}
