+swift_source_set("engine_swift") {
+  sources = [ "built_in_ai_engine.swift" ]
+  frameworks = [
+    "CoreGraphics.framework",
+    "Foundation.framework",
+    "ImageIO.framework",
+  ]
+
+  # FoundationModels exists from iOS 26 on, and Chrome runs on earlier
+  # versions. Link it weakly, and keep Swift from linking it strongly on its
