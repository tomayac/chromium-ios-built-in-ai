@@ -0,0 +1,59 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview The transport between the built-in AI polyfills in the page
+ * and the on-device models of the browser. It is the bridge that the
+ * polyfill's `native` backend looks for: `send()` posts one message to the
+ * browser, and every event the browser sends back goes to the callback given
+ * to `listen()`.
+ */
+
+import {CrWebApi, gCrWeb} from '//ios/web/public/js_messaging/resources/gcrweb.js';
+import {sendWebKitMessage} from '//ios/web/public/js_messaging/resources/utils.js';
+
+const HANDLER_NAME = 'BuiltInAIMessageHandler';
+
+type Listener = (event: object) => void;
+
+let listener: Listener|null = null;
+
+// Called by the browser with each event, as a JSON string.
+function deliver(event: string): void {
+  if (!listener) {
+    return;
+  }
+  let parsed: object;
+  try {
+    parsed = JSON.parse(event);
+  } catch {
+    return;
+  }
+  listener(parsed);
+}
+
+// The built-in AI APIs exist in secure contexts only.
+if (window.isSecureContext) {
+  const builtInAI = new CrWebApi('builtInAI');
+  builtInAI.addFunction('deliver', deliver);
+  gCrWeb.registerApi(builtInAI);
+
+  const bridge = Object.freeze({
+    send(message: object): void {
+      sendWebKitMessage(HANDLER_NAME, {
+        'frameId': gCrWeb.getFrameId(),
+        'message': JSON.stringify(message),
+      });
+    },
+    listen(callback: Listener): void {
+      listener = callback;
+    },
+  });
+  Object.defineProperty(window, '__builtInAINativeBridge', {
+    value: bridge,
+    writable: false,
+    configurable: false,
+    enumerable: false,
+  });
+}
