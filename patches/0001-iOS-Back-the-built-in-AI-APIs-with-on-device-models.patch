+#!/usr/bin/env python3
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+"""Fetches the LiteRT-LM Swift API and its prebuilt iOS framework.
+
+Both come from the release named by `VERSION`: the Swift wrapper sources into
+`src/swift/`, and `CLiteRTLM.xcframework`, whose checksum is pinned, into
+`prebuilt/`. Neither is checked in. Run again after changing `VERSION`.
+"""
+
+import hashlib
+import io
+import os
+import shutil
+import sys
+import urllib.request
+import zipfile
+
+VERSION = 'v0.18.0'
+XCFRAMEWORK_SHA256 = (
+    'd765b99592d4ec3d0c9e2bd69469454af06c834861340672da1891c0c121c347')
+XCFRAMEWORK_URL = ('https://github.com/google-ai-edge/LiteRT-LM/releases/'
+                   f'download/{VERSION}/CLiteRTLM.xcframework.zip')
+RAW_URL = ('https://raw.githubusercontent.com/google-ai-edge/LiteRT-LM/'
+           f'{VERSION}/swift/')
+
+# The sources of the `LiteRTLM` SwiftPM target, without its tests.
+SWIFT_SOURCES = [
+    'Benchmark.swift',
+    'Config.swift',
+    'Conversation.swift',
+    'EmbeddingEngine.swift',
+    'EmbeddingEngineConfig.swift',
+    'Engine.swift',
+    'ExperimentalFlags.swift',
+    'LiteRTLMError.swift',
+    'Message.swift',
+    'ModelInfo.swift',
+    'ResponseFormat.swift',
+    'Tool.swift',
+    'ToolManager.swift',
+]
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+
+def download(url):
+  with urllib.request.urlopen(url) as response:
+    return response.read()
+
+
+def fetch_sources():
+  directory = os.path.join(HERE, 'src', 'swift')
+  os.makedirs(directory, exist_ok=True)
+  for name in SWIFT_SOURCES:
+    with open(os.path.join(directory, name), 'wb') as f:
+      f.write(download(RAW_URL + name))
+  with open(os.path.join(HERE, 'src', 'LICENSE'), 'wb') as f:
+    f.write(download(RAW_URL.replace('/swift/', '/LICENSE')))
+
+
+def fetch_framework():
+  data = download(XCFRAMEWORK_URL)
+  digest = hashlib.sha256(data).hexdigest()
+  if digest != XCFRAMEWORK_SHA256:
+    sys.exit(f'CLiteRTLM.xcframework.zip: sha256 {digest}, '
+             f'expected {XCFRAMEWORK_SHA256}')
+  directory = os.path.join(HERE, 'prebuilt')
+  shutil.rmtree(directory, ignore_errors=True)
+  os.makedirs(directory)
+  with zipfile.ZipFile(io.BytesIO(data)) as archive:
+    for info in archive.infolist():
+      path = archive.extract(info, directory)
+      # zipfile drops the permission bits, which the dylib needs.
+      mode = info.external_attr >> 16
+      if mode:
+        os.chmod(path, mode)
+
+
+def main():
+  fetch_sources()
+  fetch_framework()
+  with open(os.path.join(HERE, 'prebuilt', 'VERSION'), 'w') as f:
+    f.write(VERSION + '\n')
+  print(f'LiteRT-LM {VERSION} fetched.')
+
+
+if __name__ == '__main__':
+  main()
