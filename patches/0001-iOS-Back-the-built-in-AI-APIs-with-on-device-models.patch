diff --git a/ios/chrome/browser/built_in_ai/model/built_in_ai_engine.swift b/ios/chrome/browser/built_in_ai/model/built_in_ai_engine.swift
new file mode 100644
index 0000000000000..13fd93d193869
--- /dev/null
+++ b/ios/chrome/browser/built_in_ai/model/built_in_ai_engine.swift
@@ -0,0 +1,1188 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Native half of the built-in AI APIs (`LanguageModel` and the task APIs
+// layered on it) for WebKit-based Chrome.
+//
+// Pages talk to `BuiltInAIEngine` through JSON messages, one per call, and get
+// JSON events back. The page side is the `native` backend of the Prompt API
+// polyfill, which already keeps the conversation history, so every `generate`
+// message carries the full conversation and this engine needs no state beyond
+// what makes the next turn cheap.
+//
+// Two models sit behind it:
+//
+// - Apple Foundation Models (`SystemLanguageModel`), the default whenever the
+//   device has Apple Intelligence and the request fits the model.
+// - Gemma 4 E2B through LiteRT-LM, the fallback for devices without Apple
+//   Intelligence and for audio input. It is downloaded once into the app
+//   container and shared by every origin.
+//
+// Messages (page to native), all with a string `id`:
+//   {cmd: "availability", options}
+//   {cmd: "create", session, options}
+//   {cmd: "generate", session, contents, schema?, omitSchemaInput?, stream}
+//   {cmd: "countTokens", session, contents}
+//   {cmd: "abort", target}
+//   {cmd: "destroy", session}
+// Events (native to page):
+//   {id, type: "result", value}
+//   {id, type: "error", name, message}
+//   {id, type: "chunk", text}
+//   {id, type: "progress", loaded}
+//
+// `contents` uses the polyfill's wire format:
+//   [{role: "user" | "model" | "system", parts: [{text} | {inlineData: {mimeType, data}}]}]
+
+import CoreGraphics
+import Foundation
+import ImageIO
+
+#if canImport(FoundationModels)
+  import FoundationModels
+#endif
+#if canImport(LiteRTLM)
+  import LiteRTLM
+#endif
+#if canImport(UIKit)
+  import UIKit
+#endif
+
+// MARK: - Public entry point
+
+/// Receives messages from pages and sends events back to them.
+///
+/// `client` identifies the frame a message came from. Sessions belong to their
+/// client, and `releaseClient(_:)` drops all of them when the frame goes away.
+@objc(BuiltInAIEngine)
+public final class BuiltInAIEngine: NSObject, @unchecked Sendable {
+  @objc(sharedEngine) public static let shared = BuiltInAIEngine()
+
+  private let core = EngineCore()
+
+  /// Where downloaded models are kept. Defaults to
+  /// `Application Support/BuiltInAI/Models`.
+  @objc public var modelDirectory: URL {
+    get { GemmaModelStore.shared.directory }
+    set { GemmaModelStore.shared.directory = newValue }
+  }
+
+  /// Handles one JSON message. `emit` receives every event for it as a JSON
+  /// string, on an arbitrary thread.
+  @objc(handleMessage:client:emit:)
+  public func handleMessage(
+    _ json: String, client: String, emit: @escaping @Sendable (String) -> Void
+  ) {
+    let sink = EventSink(emit)
+    guard let data = json.data(using: .utf8),
+      let message = (try? JSONSerialization.jsonObject(with: data)) as? [String: Any],
+      let id = message["id"] as? String,
+      let cmd = message["cmd"] as? String
+    else {
+      return
+    }
+    let request = Request(id: id, client: client, cmd: cmd, body: message, sink: sink)
+    Task { await core.handle(request) }
+  }
+
+  /// Destroys every session `client` created and cancels its pending work.
+  @objc(releaseClient:)
+  public func releaseClient(_ client: String) {
+    Task { await core.release(client: client) }
+  }
+}
+
+// MARK: - Plumbing
+
+/// A message from a page, with a way to answer it.
+struct Request: @unchecked Sendable {
+  let id: String
+  let client: String
+  let cmd: String
+  let body: [String: Any]
+  let sink: EventSink
+
+  func result(_ value: Any) { sink.send(["id": id, "type": "result", "value": value]) }
+  func chunk(_ text: String) { sink.send(["id": id, "type": "chunk", "text": text]) }
+  func progress(_ loaded: Double) { sink.send(["id": id, "type": "progress", "loaded": loaded]) }
+  func fail(_ error: Error) {
+    let failure = BuiltInAIError.from(error)
+    sink.send(["id": id, "type": "error", "name": failure.name, "message": failure.message])
+  }
+}
+
+final class EventSink: @unchecked Sendable {
+  private let emit: @Sendable (String) -> Void
+  init(_ emit: @escaping @Sendable (String) -> Void) { self.emit = emit }
+
+  func send(_ event: [String: Any]) {
+    guard let data = try? JSONSerialization.data(withJSONObject: event),
+      let json = String(data: data, encoding: .utf8)
+    else { return }
+    emit(json)
+  }
+}
+
+/// An error that maps onto the `DOMException` the page should see.
+struct BuiltInAIError: Error {
+  let name: String
+  let message: String
+
+  static func notSupported(_ message: String) -> Self { .init(name: "NotSupportedError", message: message) }
+  static func invalidState(_ message: String) -> Self { .init(name: "InvalidStateError", message: message) }
+  static func notAllowed(_ message: String) -> Self { .init(name: "NotAllowedError", message: message) }
+  static func operation(_ message: String) -> Self { .init(name: "OperationError", message: message) }
+  static func syntax(_ message: String) -> Self { .init(name: "SyntaxError", message: message) }
+  static func network(_ message: String) -> Self { .init(name: "NetworkError", message: message) }
+
+  static func from(_ error: Error) -> Self {
+    if let error = error as? BuiltInAIError { return error }
+    if error is CancellationError {
+      return .init(name: "AbortError", message: "The operation was aborted.")
+    }
+    #if canImport(FoundationModels)
+      if #available(iOS 27.0, macOS 27.0, *), let error = error as? LanguageModelError {
+        return fromLanguageModelError(error)
+      }
+      if #available(iOS 26.0, macOS 26.0, *),
+        let error = error as? LanguageModelSession.GenerationError
+      {
+        return fromGenerationError(error)
+      }
+    #endif
+    return .operation(error.localizedDescription)
+  }
+
+  #if canImport(FoundationModels)
+    @available(iOS 27.0, macOS 27.0, *)
+    private static func fromLanguageModelError(_ error: LanguageModelError) -> Self {
+      let text = error.localizedDescription
+      switch error {
+      case .contextSizeExceeded:
+        return .init(name: "QuotaExceededError", message: text)
+      case .unsupportedCapability, .unsupportedTranscriptContent, .unsupportedGenerationGuide,
+        .unsupportedLanguageOrLocale:
+        return .notSupported(text)
+      case .guardrailViolation, .refusal:
+        return .init(name: "NotReadableError", message: text)
+      case .rateLimited, .timeout:
+        return .operation(text)
+      @unknown default:
+        return .operation(text)
+      }
+    }
+
+    /// Errors as iOS 26 throws them.
+    @available(iOS 26.0, macOS 26.0, *)
+    private static func fromGenerationError(_ error: LanguageModelSession.GenerationError) -> Self {
+      let text = error.localizedDescription
+      switch error {
+      case .exceededContextWindowSize:
+        return .init(name: "QuotaExceededError", message: text)
+      case .unsupportedLanguageOrLocale, .unsupportedGuide:
+        return .notSupported(text)
+      case .guardrailViolation, .refusal:
+        return .init(name: "NotReadableError", message: text)
+      case .rateLimited, .concurrentRequests, .assetsUnavailable, .decodingFailure:
+        return .operation(text)
+      @unknown default:
+        return .operation(text)
+      }
+    }
+  #endif
+}
+
+// MARK: - Request options
+
+/// The parts of `LanguageModelCreateOptions` the engine cares about.
+struct ModelRequirements {
+  var inputTypes: Set<String> = ["text"]
+  var languages: [String] = []
+  /// "auto", "apple", or "gemma". Pages never set this; the browser does, for
+  /// testing and for a user setting.
+  var preferredBackend = "auto"
+
+  init(_ options: [String: Any]?) {
+    guard let options else { return }
+    for key in ["expectedInputs", "expectedOutputs"] {
+      for entry in options[key] as? [[String: Any]] ?? [] {
+        if key == "expectedInputs", let type = entry["type"] as? String {
+          inputTypes.insert(type)
+        }
+        languages += entry["languages"] as? [String] ?? []
+      }
+    }
+    if let backend = options["backend"] as? String { preferredBackend = backend }
+  }
+}
+
+/// Which model serves a request, and whether it can right now.
+enum BackendKind: String {
+  case apple
+  case gemma
+}
+
+enum Availability: String {
+  case unavailable
+  case downloadable
+  case downloading
+  case available
+}
+
+// MARK: - Engine state
+
+actor EngineCore {
+  private var sessions: [String: AISession] = [:]  // key: "client|session"
+  private var tasks: [String: (client: String, task: Task<Void, Never>)] = [:]  // key: request id
+
+  func handle(_ request: Request) async {
+    switch request.cmd {
+    case "availability":
+      let options = request.body["options"] as? [String: Any]
+      request.result(await Router.availability(for: ModelRequirements(options)).rawValue)
+    case "create":
+      track(request) { await self.create(request) }
+    case "generate":
+      track(request) { await self.generate(request) }
+    case "countTokens":
+      track(request) { await self.countTokens(request) }
+    case "abort":
+      if let target = request.body["target"] as? String,
+        let entry = tasks[target], entry.client == request.client
+      {
+        entry.task.cancel()
+      }
+      request.result(NSNull())
+    case "destroy":
+      if let key = sessionKey(request) {
+        sessions.removeValue(forKey: key)?.cancelAll()
+      }
+      request.result(NSNull())
+    default:
+      request.fail(BuiltInAIError.notSupported("Unknown command \(request.cmd)."))
+    }
+  }
+
+  func release(client: String) {
+    for (key, session) in sessions where key.hasPrefix(client + "|") {
+      session.cancelAll()
+      sessions.removeValue(forKey: key)
+    }
+    for (id, entry) in tasks where entry.client == client {
+      entry.task.cancel()
+      tasks.removeValue(forKey: id)
+    }
+  }
+
+  private func track(_ request: Request, _ work: @escaping @Sendable () async -> Void) {
+    let task = Task { await work() }
+    tasks[request.id] = (request.client, task)
+    Task {
+      await task.value
+      self.finished(request.id)
+    }
+  }
+
+  private func finished(_ id: String) { tasks.removeValue(forKey: id) }
+
+  private func sessionKey(_ request: Request) -> String? {
+    guard let session = request.body["session"] as? String else { return nil }
+    return request.client + "|" + session
+  }
+
+  private func create(_ request: Request) async {
+    do {
+      guard let key = sessionKey(request) else {
+        throw BuiltInAIError.syntax("Missing session id.")
+      }
+      let options = request.body["options"] as? [String: Any] ?? [:]
+      let requirements = ModelRequirements(options)
+      let backend = try await Router.prepare(
+        for: requirements,
+        userActivated: request.body["userActivated"] as? Bool ?? false,
+        progress: { request.progress($0) })
+      try Task.checkCancellation()
+      let session = try AISession(backend: backend, options: options)
+      sessions[key] = session
+      request.result([
+        "backend": backend.rawValue,
+        "contextWindow": session.contextWindow,
+      ])
+    } catch {
+      request.fail(error)
+    }
+  }
+
+  private func generate(_ request: Request) async {
+    do {
+      let session = try lookup(request)
+      let contents = try ChatContents(request.body["contents"])
+      let schema = try (request.body["schema"] as? [String: Any]).map {
+        try JSONSerialization.data(withJSONObject: $0)
+      }
+      let omitSchemaInput = request.body["omitSchemaInput"] as? Bool ?? false
+      var onChunk: (@Sendable (String) -> Void)?
+      if request.body["stream"] as? Bool ?? false {
+        onChunk = { text in request.chunk(text) }
+      }
+      let output = try await session.generate(
+        contents, schema: schema, includeSchemaInPrompt: !omitSchemaInput, onChunk: onChunk)
+      request.result(["text": output.text, "usage": output.usage])
+    } catch {
+      request.fail(error)
+    }
+  }
+
+  private func countTokens(_ request: Request) async {
+    do {
+      let session = try lookup(request)
+      let contents = try ChatContents(request.body["contents"])
+      request.result(try await session.countTokens(contents))
+    } catch {
+      request.fail(error)
+    }
+  }
+
+  private func lookup(_ request: Request) throws -> AISession {
+    guard let key = sessionKey(request), let session = sessions[key] else {
+      throw BuiltInAIError.invalidState("The session does not exist or was destroyed.")
+    }
+    return session
+  }
+}
+
+// MARK: - Model selection
+
+enum Router {
+  /// Answers `LanguageModel.availability()`: the best state among the models
+  /// that could serve these options, Apple's model first.
+  static func availability(for requirements: ModelRequirements) async -> Availability {
+    let candidates = order(requirements.preferredBackend)
+    var best = Availability.unavailable
+    for kind in candidates {
+      let state = await availability(of: kind, for: requirements)
+      if state == .available { return .available }
+      if rank(state) > rank(best) { best = state }
+    }
+    return best
+  }
+
+  /// Picks the model for a new session, downloading it first if it has to.
+  static func prepare(
+    for requirements: ModelRequirements, userActivated: Bool,
+    progress: @escaping @Sendable (Double) -> Void
+  ) async throws -> BackendKind {
+    var downloadable: BackendKind?
+    for kind in order(requirements.preferredBackend) {
+      switch await availability(of: kind, for: requirements) {
+      case .available:
+        progress(0)
+        progress(1)
+        return kind
+      case .downloading, .downloadable:
+        if downloadable == nil { downloadable = kind }
+      case .unavailable:
+        continue
+      }
+    }
+    guard let kind = downloadable else {
+      throw BuiltInAIError.notSupported("No on-device model supports these options.")
+    }
+    switch kind {
+    case .apple:
+      // The system downloads Apple's model on its own schedule and reports no
+      // progress. Wait for it with indeterminate progress.
+      progress(0)
+      try await AppleModel.waitUntilReady()
+      progress(1)
+    case .gemma:
+      let state = await GemmaModelStore.shared.state
+      if case .absent = state, !userActivated {
+        throw BuiltInAIError.notAllowed(
+          "Downloading the model requires a user gesture.")
+      }
+      try await GemmaModelStore.shared.ensureDownloaded(progress: progress)
+    }
+    return kind
+  }
+
+  private static func order(_ preferred: String) -> [BackendKind] {
+    switch preferred {
+    case "apple": return [.apple]
+    case "gemma": return [.gemma]
+    default: return [.apple, .gemma]
+    }
+  }
+
+  private static func rank(_ state: Availability) -> Int {
+    switch state {
+    case .unavailable: return 0
+    case .downloadable: return 1
+    case .downloading: return 2
+    case .available: return 3
+    }
+  }
+
+  private static func availability(
+    of kind: BackendKind, for requirements: ModelRequirements
+  ) async -> Availability {
+    switch kind {
+    case .apple: return AppleModel.availability(for: requirements)
+    case .gemma: return await GemmaModelStore.shared.availability(for: requirements)
+    }
+  }
+}
+
+enum AppleModel {
+  static func availability(for requirements: ModelRequirements) -> Availability {
+    #if canImport(FoundationModels)
+      guard #available(iOS 26.0, macOS 26.0, *) else { return .unavailable }
+      let model = SystemLanguageModel.default
+      for type in requirements.inputTypes {
+        switch type {
+        case "text":
+          continue
+        case "image":
+          guard #available(iOS 27.0, macOS 27.0, *),
+            model.capabilities.contains(.vision)
+          else { return .unavailable }
+        default:
+          // No audio input.
+          return .unavailable
+        }
+      }
+      for tag in requirements.languages where !supports(model, tag) {
+        return .unavailable
+      }
+      switch model.availability {
+      case .available:
+        return .available
+      case .unavailable(.modelNotReady):
+        return .downloading
+      case .unavailable:
+        // Not eligible, or Apple Intelligence is off. Gemma takes over.
+        return .unavailable
+      }
+    #else
+      return .unavailable
+    #endif
+  }
+
+  static func waitUntilReady() async throws {
+    #if canImport(FoundationModels)
+      guard #available(iOS 26.0, macOS 26.0, *) else {
+        throw BuiltInAIError.notSupported("Apple Foundation Models need iOS 26.")
+      }
+      while true {
+        switch SystemLanguageModel.default.availability {
+        case .available:
+          return
+        case .unavailable(.modelNotReady):
+          try await Task.sleep(nanoseconds: 2_000_000_000)
+        case .unavailable:
+          throw BuiltInAIError.notSupported("Apple Intelligence is unavailable.")
+        }
+      }
+    #else
+      throw BuiltInAIError.notSupported("Apple Foundation Models are unavailable.")
+    #endif
+  }
+
+  #if canImport(FoundationModels)
+    @available(iOS 26.0, macOS 26.0, *)
+    private static func supports(_ model: SystemLanguageModel, _ tag: String) -> Bool {
+      let wanted = Locale.Language(identifier: tag)
+      return model.supportedLanguages.contains {
+        $0.languageCode == wanted.languageCode
+      }
+    }
+  #endif
+}
+
+// MARK: - Conversation contents
+
+/// One part of a message, decoded from the polyfill's wire format.
+enum ChatPart {
+  case text(String)
+  case image(CGImage, Data)
+  case audio(Data)
+
+  var fingerprint: String {
+    switch self {
+    case .text(let text): return "t:" + text
+    case .image(_, let data): return "i:\(data.count):\(data.hashValue)"
+    case .audio(let data): return "a:\(data.count):\(data.hashValue)"
+    }
+  }
+}
+
+struct ChatMessage {
+  enum Role: String {
+    case user
+    case model
+    case system
+  }
+
+  let role: Role
+  let parts: [ChatPart]
+
+  var text: String {
+    parts.compactMap {
+      if case .text(let text) = $0 { return text } else { return nil }
+    }.joined(separator: "\n")
+  }
+
+  var fingerprint: String {
+    role.rawValue + "[" + parts.map(\.fingerprint).joined(separator: ",") + "]"
+  }
+}
+
+struct ChatContents {
+  let messages: [ChatMessage]
+
+  init(_ raw: Any?) throws {
+    guard let raw = raw as? [[String: Any]] else {
+      throw BuiltInAIError.syntax("Missing contents.")
+    }
+    messages = try raw.map { entry in
+      let role = ChatMessage.Role(rawValue: entry["role"] as? String ?? "user") ?? .user
+      let parts = try (entry["parts"] as? [[String: Any]] ?? []).map(ChatContents.part)
+      return ChatMessage(role: role, parts: parts)
+    }
+  }
+
+  init(messages: [ChatMessage]) { self.messages = messages }
+
+  private static func part(_ raw: [String: Any]) throws -> ChatPart {
+    if let text = raw["text"] as? String { return .text(text) }
+    guard let inline = raw["inlineData"] as? [String: Any],
+      let mimeType = inline["mimeType"] as? String,
+      let base64 = inline["data"] as? String,
+      let data = Data(base64Encoded: base64)
+    else {
+      throw BuiltInAIError.syntax("Unsupported message part.")
+    }
+    if mimeType.hasPrefix("image/") {
+      guard let source = CGImageSourceCreateWithData(data as CFData, nil),
+        let image = CGImageSourceCreateImageAtIndex(source, 0, nil)
+      else {
+        throw BuiltInAIError.init(name: "InvalidStateError", message: "The image could not be decoded.")
+      }
+      return .image(image, data)
+    }
+    if mimeType.hasPrefix("audio/") { return .audio(data) }
+    throw BuiltInAIError.notSupported("Unsupported media type \(mimeType).")
+  }
+}
+
+struct GenerationOutput {
+  let text: String
+  let usage: Int
+}
+
+// MARK: - Sessions
+
+/// One `LanguageModel` session of one page.
+///
+/// The page resends the whole conversation every turn. Rebuilding a model
+/// session from that is correct but makes the model re-read everything, so the
+/// last model session is kept with a fingerprint of the conversation it holds,
+/// and reused whenever the page's conversation is that one plus a new prompt.
+final class AISession: @unchecked Sendable {
+  let backend: BackendKind
+  let contextWindow: Int
+  private let instructions: String?
+  private let temperature: Double?
+  private let topK: Int?
+  private let lock = NSLock()
+  private var queueTail: Task<Void, Never>?
+  private var running: Set<Task<GenerationOutput, Error>> = []
+  private var cached: (session: AnyObject, fingerprint: [String])?
+
+  init(backend: BackendKind, options: [String: Any]) throws {
+    self.backend = backend
+    self.instructions = options["systemInstruction"] as? String
+    self.temperature = (options["temperature"] as? NSNumber)?.doubleValue
+    self.topK = (options["topK"] as? NSNumber)?.intValue
+    switch backend {
+    case .apple:
+      #if canImport(FoundationModels)
+        if #available(iOS 26.0, macOS 26.0, *) {
+          contextWindow = SystemLanguageModel.default.contextSize
+        } else {
+          contextWindow = 4096
+        }
+      #else
+        contextWindow = 4096
+      #endif
+    case .gemma:
+      contextWindow = GemmaModelStore.contextWindow
+      #if canImport(LiteRTLM)
+        Task { await GemmaRuntime.shared.retain() }
+      #endif
+    }
+  }
+
+  deinit {
+    #if canImport(LiteRTLM)
+      if backend == .gemma {
+        Task { await GemmaRuntime.shared.release() }
+      }
+    #endif
+  }
+
+  func cancelAll() {
+    let tasks = lock.withLock {
+      defer { running.removeAll() }
+      return running
+    }
+    tasks.forEach { $0.cancel() }
+  }
+
+  /// Runs one turn. Turns of a session never overlap: Foundation Models
+  /// rejects concurrent requests to the same session.
+  func generate(
+    _ contents: ChatContents, schema: Data?, includeSchemaInPrompt: Bool,
+    onChunk: (@Sendable (String) -> Void)?
+  ) async throws -> GenerationOutput {
+    let task = serialized {
+      try await self.run(
+        contents, schema: schema, includeSchemaInPrompt: includeSchemaInPrompt,
+        onChunk: onChunk)
+    }
+    defer { _ = lock.withLock { running.remove(task) } }
+    return try await withTaskCancellationHandler {
+      try await task.value
+    } onCancel: {
+      task.cancel()
+    }
+  }
+
+  func countTokens(_ contents: ChatContents) async throws -> Int {
+    #if canImport(FoundationModels)
+      if backend == .apple, #available(iOS 26.4, macOS 26.4, *) {
+        let entries = Self.transcriptEntries(instructions: nil, messages: contents.messages)
+        return try await SystemLanguageModel.default.tokenCount(for: entries)
+      }
+    #endif
+    // LiteRT-LM counts tokens only once they are in a conversation. Four
+    // characters a token is close enough for English text.
+    let characters = contents.messages.reduce(0) { $0 + $1.text.count }
+    let media = contents.messages.reduce(0) { total, message in
+      total + message.parts.filter { if case .text = $0 { false } else { true } }.count * 256
+    }
+    return (characters + 3) / 4 + media
+  }
+
+  private func serialized(
+    _ work: @escaping @Sendable () async throws -> GenerationOutput
+  ) -> Task<GenerationOutput, Error> {
+    lock.withLock {
+      let previous = queueTail
+      let task = Task<GenerationOutput, Error> {
+        await previous?.value
+        try Task.checkCancellation()
+        return try await work()
+      }
+      queueTail = Task { _ = try? await task.value }
+      running.insert(task)
+      return task
+    }
+  }
+
+  private func run(
+    _ contents: ChatContents, schema: Data?, includeSchemaInPrompt: Bool,
+    onChunk: (@Sendable (String) -> Void)?
+  ) async throws -> GenerationOutput {
+    switch backend {
+    case .apple:
+      #if canImport(FoundationModels)
+        if #available(iOS 26.0, macOS 26.0, *) {
+          return try await runFoundationModels(
+            contents, schema: schema, includeSchemaInPrompt: includeSchemaInPrompt,
+            onChunk: onChunk)
+        }
+      #endif
+      throw BuiltInAIError.notSupported("Apple Foundation Models need iOS 26.")
+    case .gemma:
+      #if canImport(LiteRTLM)
+        return try await runLiteRT(
+          contents, schema: schema, includeSchemaInPrompt: includeSchemaInPrompt,
+          onChunk: onChunk)
+      #else
+        throw BuiltInAIError.notSupported("This build has no Gemma.")
+      #endif
+    }
+  }
+
+  /// The system prompt: the session's, then any system messages of the page.
+  private func systemText(_ messages: [ChatMessage]) -> String {
+    ([instructions] + messages.filter { $0.role == .system }.map(\.text))
+      .compactMap { $0 }.filter { !$0.isEmpty }.joined(separator: "\n")
+  }
+
+  /// Takes the kept model session if it holds exactly `history`. It is taken
+  /// out for the turn, and put back only if the turn succeeds, so an aborted or
+  /// failed turn never leaves a half-finished exchange in a reused session.
+  private func takeCached(matching history: [String]) -> AnyObject? {
+    lock.withLock {
+      defer { cached = nil }
+      guard let cached, cached.fingerprint == history else { return nil }
+      return cached.session
+    }
+  }
+
+  private func remember(_ session: AnyObject, fingerprint: [String]) {
+    lock.withLock { cached = (session, fingerprint) }
+  }
+
+  #if canImport(LiteRTLM)
+    private func runLiteRT(
+      _ contents: ChatContents, schema: Data?, includeSchemaInPrompt: Bool,
+      onChunk: (@Sendable (String) -> Void)?
+    ) async throws -> GenerationOutput {
+      var messages = contents.messages.filter { $0.role != .system }
+      guard let last = messages.popLast(), last.role == .user else {
+        throw BuiltInAIError.syntax("The conversation must end with a user message.")
+      }
+      let history = messages.map(\.fingerprint)
+
+      let conversation: Conversation
+      if let reused = takeCached(matching: history) as? Conversation, reused.isAlive {
+        conversation = reused
+      } else {
+        let engine = try await GemmaRuntime.shared.engine()
+        let system = systemText(contents.messages)
+        conversation = try await engine.createConversation(
+          with: ConversationConfig(
+            systemMessage: system.isEmpty ? nil : Message(system, role: .system),
+            initialMessages: messages.map(Self.liteRTMessage),
+            samplerConfig: try liteRTSampler(structured: schema != nil),
+            thinkingConfig: ThinkingConfig(enableThinking: false),
+            enableResponseFormat: true))
+      }
+
+      var prompt = Self.liteRTMessage(last)
+      var format: ResponseFormat?
+      if let schema {
+        let json = String(decoding: schema, as: UTF8.self)
+        format = try ResponseFormat.json(schema: json)
+        if includeSchemaInPrompt {
+          prompt = Message(
+            contents: Array(prompt.contents)
+              + [.text("\n\nRespond with JSON that conforms to this JSON schema:\n\(json)")],
+            role: .user)
+        }
+      }
+
+      var text = ""
+      try await withTaskCancellationHandler {
+        for try await chunk in conversation.sendMessageStream(prompt, responseFormat: format) {
+          try Task.checkCancellation()
+          let delta = chunk.toString
+          if delta.isEmpty { continue }
+          text += delta
+          // JSON goes out whole, like Apple's, once it is complete.
+          if format == nil { onChunk?(delta) }
+        }
+      } onCancel: {
+        try? conversation.cancel()
+      }
+      if format != nil, !text.isEmpty { onChunk?(text) }
+
+      remember(
+        conversation,
+        fingerprint: history + [
+          last.fingerprint, ChatMessage(role: .model, parts: [.text(text)]).fingerprint,
+        ])
+      let usage = (try? conversation.getTokenCount()) ?? (text.count + 3) / 4
+      return GenerationOutput(text: text, usage: usage)
+    }
+
+    private func liteRTSampler(structured: Bool) throws -> SamplerConfig {
+      if structured { return try SamplerConfig(topK: 1, topP: 1, temperature: 0) }
+      let k = max(topK ?? 64, 1)
+      return try SamplerConfig(
+        topK: k, topP: 0.95, temperature: Float(k == 1 ? 0 : temperature ?? 1.0))
+    }
+
+    private static func liteRTMessage(_ message: ChatMessage) -> Message {
+      var contents: [Content] = message.parts.map { part in
+        switch part {
+        case .text(let text): return .text(text)
+        case .image(_, let data): return .imageData(data)
+        case .audio(let data): return .audioData(data)
+        }
+      }
+      if contents.isEmpty { contents = [.text("")] }
+      return Message(contents: contents, role: message.role == .model ? .model : .user)
+    }
+  #endif
+
+  #if canImport(FoundationModels)
+    @available(iOS 26.0, macOS 26.0, *)
+    private func runFoundationModels(
+      _ contents: ChatContents, schema: Data?, includeSchemaInPrompt: Bool,
+      onChunk: (@Sendable (String) -> Void)?
+    ) async throws -> GenerationOutput {
+      var messages = contents.messages.filter { $0.role != .system }
+      guard let last = messages.popLast(), last.role == .user else {
+        throw BuiltInAIError.syntax("The conversation must end with a user message.")
+      }
+      let history = messages.map(\.fingerprint)
+
+      let session =
+        takeCached(matching: history) as? LanguageModelSession ?? makeSession(history: messages)
+      let prompt = try Self.prompt(for: last.parts)
+      let options = generationOptions()
+
+      var text = ""
+      if let schema {
+        let generationSchema = try Self.generationSchema(schema)
+        if let onChunk {
+          // Partial JSON snapshots are not prefixes of each other, so a schema
+          // response is sent as one chunk once it is complete.
+          var final: GeneratedContent?
+          for try await snapshot in session.streamResponse(
+            to: prompt, schema: generationSchema,
+            includeSchemaInPrompt: includeSchemaInPrompt, options: options)
+          {
+            final = snapshot.content
+          }
+          text = final?.jsonString ?? ""
+          if !text.isEmpty { onChunk(text) }
+        } else {
+          let response = try await session.respond(
+            to: prompt, schema: generationSchema,
+            includeSchemaInPrompt: includeSchemaInPrompt, options: options)
+          text = response.content.jsonString
+        }
+      } else if let onChunk {
+        // Snapshots carry the whole response so far. The page wants deltas.
+        for try await snapshot in session.streamResponse(to: prompt, options: options) {
+          let current = snapshot.content
+          if current.hasPrefix(text) {
+            let delta = String(current.dropFirst(text.count))
+            if !delta.isEmpty { onChunk(delta) }
+            text = current
+          }
+        }
+      } else {
+        text = try await session.respond(to: prompt, options: options).content
+      }
+
+      remember(session, fingerprint: history + [last.fingerprint, ChatMessage(role: .model, parts: [.text(text)]).fingerprint])
+      return GenerationOutput(text: text, usage: try await usage(of: session))
+    }
+
+    @available(iOS 26.0, macOS 26.0, *)
+    private func makeSession(history: [ChatMessage]) -> LanguageModelSession {
+      let transcript = Transcript(
+        entries: Self.transcriptEntries(instructions: instructions, messages: history))
+      return LanguageModelSession(model: SystemLanguageModel.default, transcript: transcript)
+    }
+
+    @available(iOS 26.0, macOS 26.0, *)
+    private func generationOptions() -> GenerationOptions {
+      var sampling: GenerationOptions.SamplingMode?
+      if let topK {
+        sampling = topK <= 1 ? .greedy : .random(top: topK)
+      }
+      return GenerationOptions(samplingMode: sampling, temperature: temperature)
+    }
+
+    @available(iOS 26.0, macOS 26.0, *)
+    private func usage(of session: LanguageModelSession) async throws -> Int {
+      if #available(iOS 26.4, macOS 26.4, *) {
+        return try await SystemLanguageModel.default.tokenCount(for: session.transcript)
+      }
+      let characters = session.transcript.reduce(0) { total, entry in
+        total + String(describing: entry).count
+      }
+      return characters / 4
+    }
+
+    @available(iOS 26.0, macOS 26.0, *)
+    static func transcriptEntries(instructions: String?, messages: [ChatMessage]) -> [Transcript.Entry] {
+      var entries: [Transcript.Entry] = []
+      let system = ([instructions] + messages.filter { $0.role == .system }.map(\.text))
+        .compactMap { $0 }.filter { !$0.isEmpty }.joined(separator: "\n")
+      if !system.isEmpty {
+        entries.append(
+          .instructions(.init(segments: [.text(.init(content: system))], toolDefinitions: [])))
+      }
+      for message in messages {
+        switch message.role {
+        case .system:
+          continue
+        case .user:
+          entries.append(.prompt(.init(segments: segments(for: message.parts))))
+        case .model:
+          entries.append(
+            .response(.init(assetIDs: [], segments: [.text(.init(content: message.text))])))
+        }
+      }
+      return entries
+    }
+
+    @available(iOS 26.0, macOS 26.0, *)
+    private static func segments(for parts: [ChatPart]) -> [Transcript.Segment] {
+      parts.compactMap { part in
+        switch part {
+        case .text(let text):
+          return .text(.init(content: text))
+        case .image(let image, _):
+          if #available(iOS 27.0, macOS 27.0, *) {
+            return .attachment(.init(content: .image(.init(image))))
+          }
+          return nil
+        case .audio:
+          // Earlier turns keep only their text. Audio goes to the model only
+          // in the prompt it arrives with.
+          return nil
+        }
+      }
+    }
+
+    @available(iOS 26.0, macOS 26.0, *)
+    private static func prompt(for parts: [ChatPart]) throws -> Prompt {
+      var pieces: [Prompt] = []
+      for part in parts {
+        switch part {
+        case .text(let text):
+          pieces.append(Prompt(text))
+        case .image(let image, _):
+          guard #available(iOS 27.0, macOS 27.0, *) else {
+            throw BuiltInAIError.notSupported("Image input needs iOS 27.")
+          }
+          pieces.append(Prompt(Attachment(image)))
+        case .audio:
+          throw BuiltInAIError.notSupported("Apple's model takes no audio input.")
+        }
+      }
+      return Prompt(pieces)
+    }
+
+    /// Converts a JSON Schema `responseConstraint`. `GenerationSchema` decodes
+    /// JSON Schema directly.
+    @available(iOS 26.0, macOS 26.0, *)
+    static func generationSchema(_ schema: Data) throws -> GenerationSchema {
+      do {
+        return try JSONDecoder().decode(GenerationSchema.self, from: schema)
+      } catch {
+        throw BuiltInAIError.notSupported(
+          "The response constraint is not supported: \(error.localizedDescription)")
+      }
+    }
+  #endif
+}
+
+// MARK: - Gemma 4
+
+/// Downloads Gemma 4 E2B once into the app container and loads it for every
+/// session that needs it.
+final class GemmaModelStore: @unchecked Sendable {
+  static let shared = GemmaModelStore()
+
+  static let fileName = "gemma-4-E2B-it.litertlm"
+  static let remoteURL = URL(
+    string:
+      "https://huggingface.co/litert-community/gemma-4-E2B-it-litert-lm/resolve/main/gemma-4-E2B-it.litertlm"
+  )!
+  /// Context window for Gemma sessions. The KV cache grows with it.
+  static let contextWindow = 4096
+  /// Gemma 4 E2B runs in about 0.6 GB on the CPU and 1.5 GB on the GPU, on top
+  /// of its memory-mapped embeddings. 4 GB devices use the CPU.
+  static let minimumPhysicalMemory: UInt64 = 3_500_000_000
+  static let gpuPhysicalMemory: UInt64 = 6_000_000_000
+
+  enum State {
+    case absent
+    case downloading(Double)
+    case ready
+  }
+
+  private let lock = NSLock()
+  private var directoryOverride: URL?
+  private var download: Task<Void, Error>?
+  private var progressListeners: [UUID: @Sendable (Double) -> Void] = [:]
+  private var fraction = 0.0
+
+  var directory: URL {
+    get {
+      if let directoryOverride = lock.withLock({ directoryOverride }) { return directoryOverride }
+      if let path = ProcessInfo.processInfo.environment["BUILT_IN_AI_MODEL_DIR"] {
+        return URL(fileURLWithPath: path, isDirectory: true)
+      }
+      let support = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask)[0]
+      return support.appendingPathComponent("BuiltInAI/Models", isDirectory: true)
+    }
+    set { lock.withLock { directoryOverride = newValue } }
+  }
+
+  var modelURL: URL { directory.appendingPathComponent(Self.fileName) }
+
+  var state: State {
+    get async {
+      let downloading: Double? = lock.withLock { download != nil ? fraction : nil }
+      if let downloading { return .downloading(downloading) }
+      return FileManager.default.fileExists(atPath: modelURL.path) ? .ready : .absent
+    }
+  }
+
+  static var isSupported: Bool {
+    #if canImport(LiteRTLM)
+      return ProcessInfo.processInfo.physicalMemory >= minimumPhysicalMemory
+    #else
+      return false
+    #endif
+  }
+
+  func availability(for requirements: ModelRequirements) async -> Availability {
+    guard Self.isSupported else { return .unavailable }
+    // Gemma 4 E2B reads text, images, and audio, in 140 languages.
+    switch await state {
+    case .ready: return .available
+    case .downloading: return .downloading
+    case .absent: return .downloadable
+    }
+  }
+
+  /// Downloads the model unless it is already there. Concurrent callers share
+  /// one download and each get its progress.
+  func ensureDownloaded(progress: @escaping @Sendable (Double) -> Void) async throws {
+    let listener = UUID()
+    let path = modelURL.path
+    let joined: (task: Task<Void, Error>, fraction: Double)? = lock.withLock {
+      if FileManager.default.fileExists(atPath: path), download == nil { return nil }
+      progressListeners[listener] = progress
+      if let download { return (download, fraction) }
+      fraction = 0
+      let task = Task { try await self.fetch() }
+      download = task
+      return (task, 0)
+    }
+    guard let (task, current) = joined else {
+      progress(0)
+      progress(1)
+      return
+    }
+    progress(current)
+    defer { _ = lock.withLock { progressListeners.removeValue(forKey: listener) } }
+    try await task.value
+    progress(1)
+  }
+
+  private func report(_ value: Double) {
+    let listeners = lock.withLock {
+      fraction = value
+      return Array(progressListeners.values)
+    }
+    listeners.forEach { $0(value) }
+  }
+
+  private func fetch() async throws {
+    defer { lock.withLock { download = nil } }
+    try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+    let delegate = DownloadDelegate { [weak self] in self?.report($0) }
+    let (temporary, response) = try await URLSession.shared.download(
+      from: Self.remoteURL, delegate: delegate)
+    guard let http = response as? HTTPURLResponse, http.statusCode == 200 else {
+      throw BuiltInAIError.network("The model download failed.")
+    }
+    var destination = modelURL
+    try? FileManager.default.removeItem(at: destination)
+    try FileManager.default.moveItem(at: temporary, to: destination)
+    // Re-downloadable, so keep it out of device backups.
+    var values = URLResourceValues()
+    values.isExcludedFromBackup = true
+    try? destination.setResourceValues(values)
+  }
+}
+
+#if canImport(LiteRTLM)
+  /// The loaded Gemma model, shared by every session. Loading takes seconds
+  /// and the weights take most of a gigabyte, so there is only ever one.
+  actor GemmaRuntime {
+    static let shared = GemmaRuntime()
+
+    /// How long the model stays loaded after its last session is gone.
+    static let idleUnloadDelay: UInt64 = 60_000_000_000
+
+    private var loading: Task<Engine, Error>?
+    private var users = 0
+    private var generation = 0
+
+    init() {
+      #if canImport(UIKit)
+        NotificationCenter.default.addObserver(
+          forName: UIApplication.didReceiveMemoryWarningNotification, object: nil, queue: nil
+        ) { _ in
+          Task { await GemmaRuntime.shared.unloadIfIdle() }
+        }
+      #endif
+    }
+
+    /// A session holds the model from its creation until it is gone.
+    func retain() { users += 1 }
+
+    func release() {
+      users -= 1
+      guard users == 0 else { return }
+      generation += 1
+      let current = generation
+      Task {
+        try? await Task.sleep(nanoseconds: Self.idleUnloadDelay)
+        await self.unloadIfIdle(generation: current)
+      }
+    }
+
+    /// Drops the model unless a session uses it, or one came and went since
+    /// `generation`. The engine frees its memory once nothing references it.
+    func unloadIfIdle(generation: Int? = nil) {
+      guard users == 0, generation == nil || generation == self.generation else { return }
+      loading = nil
+    }
+
+    func engine() async throws -> Engine {
+      if let loading { return try await loading.value }
+      let task = Task { try await Self.load() }
+      loading = task
+      do {
+        return try await task.value
+      } catch {
+        loading = nil
+        throw error
+      }
+    }
+
+    private static func load() async throws -> Engine {
+      let useGPU = ProcessInfo.processInfo.physicalMemory >= GemmaModelStore.gpuPhysicalMemory
+      let backend: Backend = useGPU ? .gpu : .cpu()
+      let caches = FileManager.default.urls(for: .cachesDirectory, in: .userDomainMask)[0]
+        .appendingPathComponent("BuiltInAI", isDirectory: true)
+      try FileManager.default.createDirectory(at: caches, withIntermediateDirectories: true)
+      let engine = Engine(
+        engineConfig: try EngineConfig(
+          modelPath: GemmaModelStore.shared.modelURL.path, backend: backend,
+          visionBackend: backend, audioBackend: .cpu(),
+          maxNumTokens: GemmaModelStore.contextWindow, cacheDir: caches.path))
+      try await engine.initialize()
+      return engine
+    }
+  }
+#endif
+
+private final class DownloadDelegate: NSObject, URLSessionTaskDelegate, @unchecked Sendable {
+  private let onProgress: @Sendable (Double) -> Void
+  private var observation: NSKeyValueObservation?
+
+  init(onProgress: @escaping @Sendable (Double) -> Void) { self.onProgress = onProgress }
+
+  func urlSession(_ session: URLSession, didCreateTask task: URLSessionTask) {
+    observation = task.progress.observe(\.fractionCompleted) { [onProgress] progress, _ in
+      onProgress(progress.fractionCompleted)
+    }
+  }
+}
