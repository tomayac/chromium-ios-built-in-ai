+// The system prompt of `api` for `key`, in the output language.
+std::string SystemPrompt(std::string_view api,
+                         const std::string& key,
+                         bool with_context,
+                         const std::string& output_language) {
+  const base::DictValue* prompts = TaskPrompts().FindDict(api);
+  const base::DictValue* entry = prompts ? prompts->FindDict(key) : nullptr;
+  const std::string* prompt =
+      entry ? entry->FindString(with_context ? "systemWithContext" : "system")
+            : nullptr;
+  std::string result = prompt ? *prompt : "";
+  base::ReplaceSubstringsAfterOffset(&result, 0, "{{LANGUAGE}}",
+                                     LanguageName(output_language));
+  return result;
+}
+
+// A call's prompt, as the polyfills put it: the text, after any context.
+std::string UserPrompt(const std::string& input,
+                       const std::string& shared_context,
+                       const std::string& context) {
+  std::string combined(base::TrimWhitespaceASCII(
+      base::StrCat({shared_context, " ", context}), base::TRIM_ALL));
+  return combined.empty() ? base::StrCat({"TEXT: ", input})
+                          : base::StrCat({"CONTEXT: ", combined, " TEXT: ",
+                                          input});
+}
+
+std::vector<std::string> Codes(
+    const std::vector<blink::mojom::AILanguageCodePtr>& languages) {
+  std::vector<std::string> codes;
+  for (const auto& language : languages) {
+    codes.push_back(language->code);
+  }
+  return codes;
+}
+
+std::string Code(const blink::mojom::AILanguageCodePtr& language) {
+  return language ? language->code : "";
+}
