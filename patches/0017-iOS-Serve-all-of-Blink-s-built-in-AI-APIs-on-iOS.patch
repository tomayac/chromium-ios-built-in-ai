+// A Summarizer, Writer, or Rewriter: a prompt task, and the context shared by
+// its calls.
+template <typename Interface>
+class TaskObject : public Interface {
+ public:
+  TaskObject(std::unique_ptr<PromptTask> task, std::string shared_context)
+      : task_(std::move(task)), shared_context_(std::move(shared_context)) {}
+
+  PromptTask& task() { return *task_; }
+
+ protected:
+  std::string Prompt(const std::string& input,
+                     const std::string& context) const {
+    return UserPrompt(input, shared_context_, context);
+  }
+
+  std::unique_ptr<PromptTask> task_;
+  const std::string shared_context_;
+};
+
+class Summarizer : public TaskObject<blink::mojom::AISummarizer> {
+ public:
+  using TaskObject::TaskObject;
+  void Summarize(const std::string& input,
+                 const std::string& context,
+                 mojo::PendingRemote<blink::mojom::ModelStreamingResponder>
+                     responder) override {
+    task_->Run(Prompt(input, context), std::move(responder));
+  }
+  void MeasureUsage(const std::string& input,
+                    const std::string& context,
+                    MeasureUsageCallback callback) override {
+    task_->MeasureUsage(Prompt(input, context), std::move(callback));
+  }
+};
