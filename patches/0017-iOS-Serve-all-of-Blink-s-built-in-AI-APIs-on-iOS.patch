+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef IOS_CHROME_BROWSER_BUILT_IN_AI_MODEL_BLINK_PROMPT_TASK_H_
+#define IOS_CHROME_BROWSER_BUILT_IN_AI_MODEL_BLINK_PROMPT_TASK_H_
+
+#include <map>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "ios/chrome/browser/built_in_ai/model/blink/engine_client.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "mojo/public/cpp/bindings/remote_set.h"
+#include "services/on_device_model/public/mojom/download_observer.mojom.h"
+#include "third_party/blink/public/mojom/ai/ai_manager.mojom-forward.h"
+#include "third_party/blink/public/mojom/ai/model_streaming_responder.mojom.h"
+
+namespace built_in_ai {
+
+// The engine's availability answer as Blink's.
+blink::mojom::ModelAvailabilityCheckResult ToAvailability(
+    const std::string& value);
+
+// An engine failure as a streaming status.
+blink::mojom::ModelStreamingResponseStatus ToStatus(
+    const EngineClient::Error& error);
+
+// The task API polyfills' prompts: the system prompts of Summarizer, Writer,
+// and Rewriter by API and options, and Translator's.
+const base::DictValue& TaskPrompts();
+
+// The English name of the language `code` stands for, as the task API
+// polyfills put it into their prompts. English for none.
+std::string LanguageName(const std::string& code);
+
+// `expectedInputs` and `expectedOutputs` for text in these languages, English
+// for none, as the task API polyfills ask the language model.
+base::DictValue TextOptions(const std::vector<std::string>& input_languages,
+                            const std::string& output_language);
+
+// The language model session behind a task API object, such as a Summarizer:
+// a system prompt and examples, and one exchange per call, which does not
+// see the earlier ones.
+class PromptTask {
+ public:
+  struct Example {
+    std::string user;
+    std::string model;
+  };
+
+  PromptTask(std::string system_prompt,
+             std::vector<Example> examples,
+             base::DictValue options);
+  PromptTask(const PromptTask&) = delete;
+  PromptTask& operator=(const PromptTask&) = delete;
+  ~PromptTask();
+
+  // Creates the engine session, and calls `done` with its context window,
+  // or nothing if it could not be created.
+  void Start(mojo::PendingRemote<on_device_model::mojom::DownloadObserver>
+                 monitor,
+             base::OnceCallback<void(std::optional<uint64_t>)> done);
+
+  // Answers `user_prompt` to `responder`, streaming.
+  void Run(const std::string& user_prompt,
+           mojo::PendingRemote<blink::mojom::ModelStreamingResponder>
+               responder);
+
+  // The number of tokens `user_prompt` takes.
+  void MeasureUsage(const std::string& user_prompt,
+                    base::OnceCallback<void(std::optional<uint32_t>)> done);
+
+ private:
+  base::ListValue Contents(const std::string& user_prompt) const;
+  void OnDone(mojo::RemoteSetElementId responder_id,
+              base::expected<base::Value, EngineClient::Error> result);
+  void OnResponderGone(mojo::RemoteSetElementId responder_id);
+
+  const std::string system_prompt_;
+  const std::vector<Example> examples_;
+  const base::DictValue options_;
+  EngineClient engine_;
+  mojo::RemoteSet<blink::mojom::ModelStreamingResponder> responders_;
+  std::map<mojo::RemoteSetElementId, std::string> running_;
+  base::WeakPtrFactory<PromptTask> weak_factory_{this};
+};
+
+}  // namespace built_in_ai
+
+#endif  // IOS_CHROME_BROWSER_BUILT_IN_AI_MODEL_BLINK_PROMPT_TASK_H_
diff --git a/ios/chrome/browser/built_in_ai/model/blink/prompt_task.mm b/ios/chrome/browser/built_in_ai/model/blink/prompt_task.mm
new file mode 100644
index 0000000000000..c604d9e73a6df
--- /dev/null
+++ b/ios/chrome/browser/built_in_ai/model/blink/prompt_task.mm
@@ -0,0 +1,258 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "ios/chrome/browser/built_in_ai/model/blink/prompt_task.h"
+
+#import "base/functional/bind.h"
+#import "base/json/json_reader.h"
+#import "base/no_destructor.h"
+#import "base/numerics/safe_conversions.h"
+#import "base/strings/utf_string_conversions.h"
+#import "mojo/public/cpp/bindings/remote.h"
+#import "third_party/blink/public/mojom/ai/ai_common.mojom.h"
+#import "third_party/blink/public/mojom/ai/ai_manager.mojom.h"
+#import "ios/chrome/browser/built_in_ai/model/blink/task_prompts.h"
+#import "ui/base/l10n/l10n_util.h"
+
+namespace built_in_ai {
+
+namespace {
+
+// Download progress goes to Blink as a share of this many bytes.
+constexpr uint64_t kProgressTotal = 0x10000;
+
+base::DictValue TextMessage(std::string_view role, const std::string& text) {
+  base::DictValue part;
+  part.Set("text", text);
+  base::ListValue parts;
+  parts.Append(std::move(part));
+  base::DictValue message;
+  message.Set("role", role);
+  message.Set("parts", std::move(parts));
+  return message;
+}
+
+std::optional<uint32_t> TokenCount(
+    const base::expected<base::Value, EngineClient::Error>& result) {
+  if (result.has_value() && result->is_int()) {
+    return base::saturated_cast<uint32_t>(result->GetInt());
+  }
+  if (result.has_value() && result->is_double()) {
+    return base::saturated_cast<uint32_t>(result->GetDouble());
+  }
+  return std::nullopt;
+}
+
+}  // namespace
+
+const base::DictValue& TaskPrompts() {
+  static base::NoDestructor<base::DictValue> prompts(
+      base::JSONReader::ReadDict(kTaskPromptsJson,
+                                 base::JSON_PARSE_CHROMIUM_EXTENSIONS)
+          .value_or(base::DictValue()));
+  return *prompts;
+}
+
+blink::mojom::ModelAvailabilityCheckResult ToAvailability(
+    const std::string& value) {
+  using blink::mojom::ModelAvailabilityCheckResult;
+  if (value == "available") {
+    return ModelAvailabilityCheckResult::kAvailable;
+  }
+  if (value == "downloadable") {
+    return ModelAvailabilityCheckResult::kDownloadable;
+  }
+  if (value == "downloading") {
+    return ModelAvailabilityCheckResult::kDownloading;
+  }
+  return ModelAvailabilityCheckResult::kUnavailableUnknown;
+}
+
+blink::mojom::ModelStreamingResponseStatus ToStatus(
+    const EngineClient::Error& error) {
+  using blink::mojom::ModelStreamingResponseStatus;
+  if (error.name == "AbortError") {
+    return ModelStreamingResponseStatus::kErrorCancelled;
+  }
+  if (error.name == "QuotaExceededError") {
+    return ModelStreamingResponseStatus::kErrorInputTooLarge;
+  }
+  if (error.name == "NotSupportedError" || error.name == "SyntaxError") {
+    return ModelStreamingResponseStatus::kErrorInvalidRequest;
+  }
+  if (error.name == "NotAllowedError") {
+    return ModelStreamingResponseStatus::kErrorPermissionDenied;
+  }
+  return ModelStreamingResponseStatus::kErrorGenericFailure;
+}
+
+std::string LanguageName(const std::string& code) {
+  if (code.empty()) {
+    return "English";
+  }
+  std::u16string name =
+      l10n_util::GetDisplayNameForLocale(code, "en", /*is_for_ui=*/false);
+  return name.empty() ? "English" : base::UTF16ToUTF8(name);
+}
+
+base::DictValue TextOptions(const std::vector<std::string>& input_languages,
+                            const std::string& output_language) {
+  auto expected = [](const std::vector<std::string>& languages) {
+    base::ListValue codes;
+    for (const auto& language : languages) {
+      codes.Append(language);
+    }
+    if (codes.empty()) {
+      codes.Append("en");
+    }
+    base::DictValue entry;
+    entry.Set("type", "text");
+    entry.Set("languages", std::move(codes));
+    base::ListValue list;
+    list.Append(std::move(entry));
+    return list;
+  };
+  base::DictValue options;
+  options.Set("expectedInputs", expected(input_languages));
+  options.Set("expectedOutputs",
+              expected(output_language.empty()
+                           ? std::vector<std::string>()
+                           : std::vector<std::string>{output_language}));
+  return options;
+}
+
+PromptTask::PromptTask(std::string system_prompt,
+                       std::vector<Example> examples,
+                       base::DictValue options)
+    : system_prompt_(std::move(system_prompt)),
+      examples_(std::move(examples)),
+      options_(std::move(options)) {
+  responders_.set_disconnect_handler(base::BindRepeating(
+      &PromptTask::OnResponderGone, weak_factory_.GetWeakPtr()));
+}
+
+PromptTask::~PromptTask() = default;
+
+void PromptTask::Start(
+    mojo::PendingRemote<on_device_model::mojom::DownloadObserver> monitor,
+    base::OnceCallback<void(std::optional<uint64_t>)> done) {
+  base::DictValue options = options_.Clone();
+  options.Set("systemInstruction", system_prompt_);
+  base::DictValue body;
+  body.Set("session", "s");
+  body.Set("options", std::move(options));
+  // Blink only asks for a model download with user activation.
+  body.Set("userActivated", true);
+  auto on_progress = base::BindRepeating(
+      [](mojo::Remote<on_device_model::mojom::DownloadObserver>* observer,
+         double loaded) {
+        if (*observer) {
+          (*observer)->OnDownloadProgressUpdate(
+              static_cast<uint64_t>(loaded * kProgressTotal), kProgressTotal);
+        }
+      },
+      base::Owned(new mojo::Remote<on_device_model::mojom::DownloadObserver>(
+          std::move(monitor))));
+  engine_.Call(
+      "create", std::move(body),
+      base::BindOnce(
+          [](base::OnceCallback<void(std::optional<uint64_t>)> done,
+             base::expected<base::Value, EngineClient::Error> result) {
+            if (!result.has_value() || !result->is_dict()) {
+              std::move(done).Run(std::nullopt);
+              return;
+            }
+            std::move(done).Run(static_cast<uint64_t>(
+                result->GetDict().FindDouble("contextWindow").value_or(0)));
+          },
+          std::move(done)),
+      {}, std::move(on_progress));
+}
+
+base::ListValue PromptTask::Contents(const std::string& user_prompt) const {
+  base::ListValue contents;
+  for (const auto& example : examples_) {
+    contents.Append(TextMessage("user", example.user));
+    contents.Append(TextMessage("model", example.model));
+  }
+  contents.Append(TextMessage("user", user_prompt));
+  return contents;
+}
+
+void PromptTask::Run(
+    const std::string& user_prompt,
+    mojo::PendingRemote<blink::mojom::ModelStreamingResponder> responder) {
+  mojo::RemoteSetElementId responder_id = responders_.Add(std::move(responder));
+  base::DictValue body;
+  body.Set("session", "s");
+  body.Set("contents", Contents(user_prompt));
+  body.Set("stream", true);
+  auto on_chunk = base::BindRepeating(
+      [](base::WeakPtr<PromptTask> self, mojo::RemoteSetElementId responder_id,
+         const std::string& text) {
+        if (self) {
+          if (auto* responder = self->responders_.Get(responder_id)) {
+            responder->OnStreaming(text);
+          }
+        }
+      },
+      weak_factory_.GetWeakPtr(), responder_id);
+  running_[responder_id] = engine_.Call(
+      "generate", std::move(body),
+      base::BindOnce(&PromptTask::OnDone, weak_factory_.GetWeakPtr(),
+                     responder_id),
+      std::move(on_chunk));
+}
+
+void PromptTask::OnDone(
+    mojo::RemoteSetElementId responder_id,
+    base::expected<base::Value, EngineClient::Error> result) {
+  running_.erase(responder_id);
+  blink::mojom::ModelStreamingResponder* responder =
+      responders_.Get(responder_id);
+  if (!responder) {
+    return;
+  }
+  if (!result.has_value() || !result->is_dict()) {
+    responder->OnError(
+        result.has_value()
+            ? blink::mojom::ModelStreamingResponseStatus::kErrorGenericFailure
+            : ToStatus(result.error()),
+        nullptr);
+    return;
+  }
+  uint64_t usage = static_cast<uint64_t>(
+      result->GetDict().FindDouble("usage").value_or(0));
+  responder->OnCompletion(
+      blink::mojom::ModelExecutionContextInfo::New(usage, 0));
+}
+
+void PromptTask::OnResponderGone(mojo::RemoteSetElementId responder_id) {
+  auto it = running_.find(responder_id);
+  if (it == running_.end()) {
+    return;
+  }
+  base::DictValue body;
+  body.Set("target", it->second);
+  engine_.Notify("abort", std::move(body));
+  running_.erase(it);
+}
+
+void PromptTask::MeasureUsage(
+    const std::string& user_prompt,
+    base::OnceCallback<void(std::optional<uint32_t>)> done) {
+  base::DictValue body;
+  body.Set("session", "s");
+  body.Set("contents", Contents(user_prompt));
+  engine_.Call(
+      "countTokens", std::move(body),
+      base::BindOnce(
+          [](base::OnceCallback<void(std::optional<uint32_t>)> done,
+             base::expected<base::Value, EngineClient::Error> result) {
+            std::move(done).Run(TokenCount(result));
+          },
+          std::move(done)));
+}
+
+}  // namespace built_in_ai
