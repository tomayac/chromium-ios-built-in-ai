diff --git a/ios/chrome/browser/built_in_ai/model/blink/translation.mm b/ios/chrome/browser/built_in_ai/model/blink/translation.mm
new file mode 100644
index 0000000000000..ea2fb9b28f2de
--- /dev/null
+++ b/ios/chrome/browser/built_in_ai/model/blink/translation.mm
@@ -0,0 +1,232 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "ios/chrome/browser/built_in_ai/model/blink/translation.h"
+
+#import <Foundation/Foundation.h>
+
+#import <memory>
+#import <string>
+#import <utility>
+#import <vector>
+
+#import "base/files/file_path.h"
+#import "base/functional/bind.h"
+#import "base/no_destructor.h"
+#import "base/strings/strcat.h"
+#import "base/strings/sys_string_conversions.h"
+#import "base/task/sequenced_task_runner.h"
+#import "base/task/thread_pool.h"
+#import "components/language_detection/content/browser/content_language_detection_driver.h"
+#import "components/language_detection/content/common/language_detection.mojom.h"
+#import "components/language_detection/core/browser/language_detection_model_provider.h"
+#import "ios/chrome/browser/built_in_ai/model/blink/prompt_task.h"
+#import "mojo/public/cpp/bindings/receiver_set.h"
+#import "mojo/public/cpp/bindings/remote.h"
+#import "mojo/public/cpp/bindings/unique_receiver_set.h"
+#import "third_party/blink/public/mojom/on_device_translation/translation_manager.mojom.h"
+#import "third_party/blink/public/mojom/on_device_translation/translator.mojom.h"
+
+namespace built_in_ai {
+
+namespace {
+
+using blink::mojom::CanCreateTranslatorResult;
+
+class Translator : public blink::mojom::Translator {
+ public:
+  Translator(std::unique_ptr<PromptTask> task,
+             std::string source,
+             std::string target)
+      : task_(std::move(task)),
+        source_(std::move(source)),
+        target_(std::move(target)) {}
+
+  PromptTask& task() { return *task_; }
+  const std::string& source() const { return source_; }
+  const std::string& target() const { return target_; }
+
+  // blink::mojom::Translator:
+  void Translate(const std::string& input,
+                 mojo::PendingRemote<blink::mojom::ModelStreamingResponder>
+                     responder) override {
+    task_->Run(Prompt(input), std::move(responder));
+  }
+  void TranslateStreaming(
+      const std::string& input,
+      mojo::PendingRemote<blink::mojom::ModelStreamingResponder> responder)
+      override {
+    task_->Run(Prompt(input), std::move(responder));
+  }
+
+ private:
+  // As the Translator polyfill asks.
+  std::string Prompt(const std::string& input) const {
+    return base::StrCat(
+        {"SOURCE: ", source_, "\nTARGET: ", target_, "\nTEXT: ", input});
+  }
+
+  std::unique_ptr<PromptTask> task_;
+  const std::string source_;
+  const std::string target_;
+};
+
+// The Translator polyfill's system prompt and examples.
+std::unique_ptr<PromptTask> TranslatorTask(const std::string& source,
+                                           const std::string& target) {
+  const base::DictValue* prompts = TaskPrompts().FindDict("translator");
+  const std::string* system = prompts ? prompts->FindString("system") : nullptr;
+  std::vector<PromptTask::Example> examples;
+  if (const base::ListValue* list =
+          prompts ? prompts->FindList("examples") : nullptr) {
+    for (size_t i = 0; i + 1 < list->size(); i += 2) {
+      const std::string* user = (*list)[i].GetDict().FindString("content");
+      const std::string* model =
+          (*list)[i + 1].GetDict().FindString("content");
+      if (user && model) {
+        examples.push_back({*user, *model});
+      }
+    }
+  }
+  return std::make_unique<PromptTask>(system ? *system : "",
+                                      std::move(examples),
+                                      TextOptions({source}, target));
+}
+
+class TranslationManager : public blink::mojom::TranslationManager {
+ public:
+  static TranslationManager& Get() {
+    static base::NoDestructor<TranslationManager> instance;
+    return *instance;
+  }
+
+  void Bind(mojo::PendingReceiver<blink::mojom::TranslationManager> receiver) {
+    receivers_.Add(this, std::move(receiver));
+  }
+
+  // blink::mojom::TranslationManager:
+  void CreateTranslator(
+      mojo::PendingRemote<blink::mojom::TranslationManagerCreateTranslatorClient>
+          client,
+      blink::mojom::TranslatorCreateOptionsPtr options) override {
+    const std::string source = options->source_lang->code;
+    const std::string target = options->target_lang->code;
+    auto translator = std::make_unique<Translator>(
+        TranslatorTask(source, target), source, target);
+    Translator* raw = translator.get();
+    raw->task().Start(
+        std::move(options->observer_remote),
+        base::BindOnce(
+            [](std::unique_ptr<Translator> translator,
+               mojo::Remote<
+                   blink::mojom::TranslationManagerCreateTranslatorClient>
+                   client,
+               std::optional<uint64_t> context_window) {
+              if (!client) {
+                base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+                    FROM_HERE, std::move(translator));
+                return;
+              }
+              if (!context_window) {
+                client->OnResult(
+                    blink::mojom::CreateTranslatorResult::NewError(
+                        blink::mojom::CreateTranslatorError::
+                            kFailedToCreateTranslator),
+                    nullptr, nullptr);
+                // Not right away: its engine client is still delivering this.
+                base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+                    FROM_HERE, std::move(translator));
+                return;
+              }
+              auto source = blink::mojom::TranslatorLanguageCode::New(
+                  translator->source());
+              auto target = blink::mojom::TranslatorLanguageCode::New(
+                  translator->target());
+              mojo::PendingRemote<blink::mojom::Translator> remote;
+              Get().translators_.Add(std::move(translator),
+                                     remote.InitWithNewPipeAndPassReceiver());
+              client->OnResult(
+                  blink::mojom::CreateTranslatorResult::NewTranslator(
+                      std::move(remote)),
+                  std::move(source), std::move(target));
+            },
+            std::move(translator),
+            mojo::Remote<blink::mojom::TranslationManagerCreateTranslatorClient>(
+                std::move(client))));
+  }
+
+  void TranslationAvailable(blink::mojom::TranslatorLanguageCodePtr source,
+                            blink::mojom::TranslatorLanguageCodePtr target,
+                            TranslationAvailableCallback callback) override {
+    base::DictValue body;
+    body.Set("options", TextOptions({source->code}, target->code));
+    engine_.Call(
+        "availability", std::move(body),
+        base::BindOnce(
+            [](TranslationAvailableCallback callback,
+               base::expected<base::Value, EngineClient::Error> result) {
+              std::string value = result.has_value() && result->is_string()
+                                      ? result->GetString()
+                                      : "";
+              if (value == "available") {
+                std::move(callback).Run(CanCreateTranslatorResult::kReadily);
+              } else if (value == "downloadable" || value == "downloading") {
+                std::move(callback).Run(CanCreateTranslatorResult::
+                                            kAfterDownloadTranslatorCreationRequired);
+              } else {
+                std::move(callback).Run(
+                    CanCreateTranslatorResult::kNoNotSupportedLanguage);
+              }
+            },
+            std::move(callback)));
+  }
+
+ private:
+  friend class base::NoDestructor<TranslationManager>;
+  TranslationManager() = default;
+
+  EngineClient engine_;
+  mojo::ReceiverSet<blink::mojom::TranslationManager> receivers_;
+  mojo::UniqueReceiverSet<blink::mojom::Translator> translators_;
+};
+
+language_detection::ContentLanguageDetectionDriver& LanguageDetectionDriver() {
+  static base::NoDestructor<language_detection::ContentLanguageDetectionDriver>
+      driver([] {
+        auto* provider = new language_detection::LanguageDetectionModelProvider(
+            base::ThreadPool::CreateSequencedTaskRunner(
+                {base::MayBlock(), base::TaskPriority::BEST_EFFORT}));
+        NSString* path =
+            [[NSBundle mainBundle] pathForResource:@"language_detection_model"
+                                            ofType:@"tflite"];
+        if (path) {
+          provider->ReplaceModelFile(
+              base::FilePath(base::SysNSStringToUTF8(path)));
+        } else {
+          // There is no model, and none is coming.
+          provider->UnloadModelFile();
+        }
+        return provider;
+      }());
+  return *driver;
+}
+
+}  // namespace
+
+void BindTranslationManager(
+    mojo::PendingReceiver<blink::mojom::TranslationManager> receiver) {
+  TranslationManager::Get().Bind(std::move(receiver));
+}
+
+void BindLanguageDetectionDriver(
+    mojo::PendingReceiver<
+        language_detection::mojom::ContentLanguageDetectionDriver> receiver) {
+  LanguageDetectionDriver().AddReceiver(std::move(receiver));
+}
+
+void PrepareLanguageDetection() {
+  LanguageDetectionDriver();
+}
+
+}  // namespace built_in_ai
