+// Starts `object`'s engine session, and then hands it to `client` and keeps
+// it in `set`.
+template <typename Interface, typename Client>
+void StartTask(std::unique_ptr<TaskObject<Interface>> object,
+               mojo::PendingRemote<Client> client,
+               mojo::PendingRemote<on_device_model::mojom::DownloadObserver>
+                   monitor,
+               mojo::UniqueReceiverSet<Interface>* set) {
+  TaskObject<Interface>* raw = object.get();
+  raw->task().Start(
+      std::move(monitor),
+      base::BindOnce(
+          [](std::unique_ptr<TaskObject<Interface>> object,
+             mojo::Remote<Client> client,
+             mojo::UniqueReceiverSet<Interface>* set,
+             std::optional<uint64_t> context_window) {
+            if (!context_window) {
+              if (client) {
+                client->OnError(blink::mojom::AIManagerCreateClientError::
+                                    kUnableToCreateSession,
+                                nullptr);
+              }
+              // Not right away: its engine client is still delivering this.
+              base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+                  FROM_HERE, std::move(object));
+              return;
+            }
+            mojo::PendingRemote<Interface> remote;
+            set->Add(std::move(object), remote.InitWithNewPipeAndPassReceiver());
+            if (client) {
+              client->OnResult(std::move(remote), *context_window);
+            }
+          },
+          std::move(object), mojo::Remote<Client>(std::move(client)), set));
+}
+
+// Answers `callback` with the availability of text in these languages.
+void TextAvailability(
+    EngineClient& engine,
+    const std::vector<std::string>& input_languages,
+    const std::string& output_language,
+    base::OnceCallback<void(blink::mojom::ModelAvailabilityCheckResult)>
+        callback) {
+  base::DictValue body;
+  body.Set("options", TextOptions(input_languages, output_language));
+  engine.Call(
+      "availability", std::move(body),
+      base::BindOnce(
+          [](base::OnceCallback<void(
+                 blink::mojom::ModelAvailabilityCheckResult)> callback,
+             base::expected<base::Value, EngineClient::Error> result) {
+            std::move(callback).Run(
+                result.has_value() && result->is_string()
+                    ? ToAvailability(result->GetString())
+                    : ModelAvailabilityCheckResult::kUnavailableUnknown);
+          },
+          std::move(callback)));
+}
