diff --git a/third_party/litert_lm/BUILD.gn b/third_party/litert_lm/BUILD.gn
index 543e4cb818fe1..b7033296ab82d 100644
--- a/third_party/litert_lm/BUILD.gn
+++ b/third_party/litert_lm/BUILD.gn
@@ -18,6 +18,15 @@ config("clitertlm") {
   ]
 }
 
+# LiteRT-LM's Swift API is written for the Swift 5 language mode, as its
+# Package.swift declares. Appended last, so it overrides the default of 6.
+config("swift5") {
+  swiftflags = [
+    "-swift-version",
+    "5",
+  ]
+}
+
 # The `LiteRTLM` Swift module, over the prebuilt C API in CLiteRTLM.framework.
 # The app has to embed that framework, see `litert_lm_framework_dir`.
 swift_source_set("litert_lm") {
@@ -42,5 +51,8 @@ swift_source_set("litert_lm") {
 
   # Upstream code, built as upstream builds it.
   configs -= [ "//build/config/compiler:chromium_code" ]
-  configs += [ "//build/config/compiler:no_chromium_code" ]
+  configs += [
+    "//build/config/compiler:no_chromium_code",
+    ":swift5",
+  ]
 }
